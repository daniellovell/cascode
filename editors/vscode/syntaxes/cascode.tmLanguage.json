{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cascode",
  "scopeName": "source.cascode",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#blocks" },
    { "include": "#storage-types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#units" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#types" },
    { "include": "#identifiers" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cascode",
          "match": "//.*$"
        },
        {
          "name": "comment.block.cascode",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cascode",
          "match": "\\b(if|else|for|while|return|break|continue|switch|case|default)\\b"
        },
        {
          "name": "keyword.other.package.cascode",
          "match": "\\b(package|import)\\b"
        },
        {
          "name": "keyword.other.class.cascode",
          "match": "\\b(module|motif|trait|implements|extend)\\b"
        },
        {
          "name": "keyword.other.declaration.cascode",
          "match": "\\b(supply|ground|port|ports|net|param|params|env|use|spec|bench|synth|slot|phase|wrap|spice|fill|bind|with|map|bundle|char|req|ens|connect|alias|comp|taps|fixtures|validity|benches|pvt|sweep|fit|polarity|kind|value|vdd|load|source|temp|icmr|duty|cycles|slew|node|freq|sense|vref|out|on)\\b"
        },
        {
          "name": "keyword.other.directive.cascode",
          "match": "\\b(from|allow|prefer|forbid|objective|minimize|maximize|attach|using|fb|pair|new|in|out|diff|clk|bias)\\b"
        },
        {
          "name": "keyword.other.type.cascode",
          "match": "\\b(electrical|digital|analog|thermal|signal|rf)\\b"
        },
        {
          "name": "storage.modifier.cascode",
          "match": "\\b(public|private|protected|static|final|const)\\b"
        }
      ]
    },
    "storage-types": {
      "patterns": [
        {
          "name": "storage.type.primitive.cascode",
          "match": "\\b(int|float|double|real|bool|string|void|enum|capacitance|resistance|inductance)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cascode",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cascode",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.cascode",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.cascode",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.triple.cascode",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.cascode",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.cascode",
          "match": "\\b([0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?)\\b"
        },
        {
          "name": "constant.numeric.hex.cascode",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        }
      ]
    },
    "units": {
      "patterns": [
        {
          "name": "constant.numeric.unit.voltage.cascode",
          "match": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?[mkuµnpf]?V\\b"
        },
        {
          "name": "constant.numeric.unit.current.cascode",
          "match": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?[mkuµnpf]?A\\b"
        },
        {
          "name": "constant.numeric.unit.frequency.cascode",
          "match": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?[kMG]?Hz\\b"
        },
        {
          "name": "constant.numeric.unit.capacitance.cascode",
          "match": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?[mkuµnpf]?F\\b"
        },
        {
          "name": "constant.numeric.unit.resistance.ascii.cascode",
          "match": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?([kMG]?Ohm|[kMG])\\b"
        },
        {
          "name": "constant.numeric.unit.inductance.cascode",
          "match": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?[mkuµnpf]?H\\b"
        },
        {
          "name": "constant.numeric.unit.noise.cascode",
          "match": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?[mkuµnpf]?V/√Hz\\b"
        },
        {
          "name": "constant.numeric.unit.time.cascode",
          "match": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?[mkuµnpf]?s\\b"
        },
        {
          "name": "constant.numeric.unit.temperature.cascode",
          "match": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?[KC]\\b"
        },
        {
          "name": "constant.numeric.unit.power.cascode",
          "match": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?[mkuµnpf]?W\\b"
        },
        {
          "name": "constant.numeric.unit.angle.cascode",
          "match": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?deg\\b"
        },
        {
          "name": "constant.numeric.unit.db.cascode",
          "match": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?dB\\b"
        },
        {
          "name": "constant.numeric.unit.percentage.cascode",
          "match": "\\b[0-9]+\\.?[0-9]*%\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.cascode",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.cascode",
          "match": "(=|\\+=|-=|\\*=|/=)"
        },
        {
          "name": "keyword.operator.arithmetic.cascode",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.cascode",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.connection.cascode",
          "match": "(->|<-|<->)"
        },
        {
          "name": "keyword.operator.range.cascode",
          "match": "\\.\\."
        }
      ]
    },
    "blocks": {
      "patterns": [
        {
          "name": "meta.block.env.cascode",
          "begin": "\\b(env)\\b(\\s*\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.other.declaration.cascode" },
            "2": { "name": "punctuation.section.block.begin.cascode" }
          },
          "end": "(\\})",
          "endCaptures": { "1": { "name": "punctuation.section.block.end.cascode" } },
          "patterns": []
        },
        {
          "name": "meta.block.use.cascode",
          "begin": "\\b(use)\\b(\\s*\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.other.declaration.cascode" },
            "2": { "name": "punctuation.section.block.begin.cascode" }
          },
          "end": "(\\})",
          "endCaptures": { "1": { "name": "punctuation.section.block.end.cascode" } },
          "patterns": []
        },
        {
          "name": "meta.block.spec.cascode",
          "begin": "\\b(spec)\\b(\\s*\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.other.declaration.cascode" },
            "2": { "name": "punctuation.section.block.begin.cascode" }
          },
          "end": "(\\})",
          "endCaptures": { "1": { "name": "punctuation.section.block.end.cascode" } },
          "patterns": []
        },
        {
          "name": "meta.block.bench.cascode",
          "begin": "\\b(bench)\\b(\\s*\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.other.declaration.cascode" },
            "2": { "name": "punctuation.section.block.begin.cascode" }
          },
          "end": "(\\})",
          "endCaptures": { "1": { "name": "punctuation.section.block.end.cascode" } },
          "patterns": []
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.spec.cascode",
          "match": "\\b(GainBandwidth|PassbandGain|PhaseMargin|OutputSwing|NoiseIn|SlewRate|Settle|ZeroTau|Power|DynamicPower|TogglePower|Headroom|ICMR|RiseTime|FallTime|VOH|VOL|Area)\\b"
        },
        {
          "name": "support.function.bench.cascode",
          "match": "\\b(SEAmplifierACBench|FDAmplifierACBench|UnityUGF|Step|NoiseIn|StepToggle)\\b"
        },
        {
          "name": "support.function.component.cascode",
          "match": "\\b[CRL]\\s*\\("
        },
        {
          "name": "support.function.builtin.cascode",
          "match": "\\b(step|posedge|negedge|GP|PWL|affine)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.trait.cascode",
          "match": "\\b(Amplifier|SingleEndedAmplifier|FullyDiffAmplifier|AmplifierStage|DiffPairLike|CascodeLike|CurrentMirrorLike|ReferenceCircuit|VoltageReference|CurrentReference|Compensator|CurrentMirror|InverterLike|Comparator|FrontEndBlock|BasebandFilter|VariableGainAmp|OutputDriver)\\b"
        },
        {
          "name": "support.type.motif.cascode",
          "match": "\\b(DiffPair|CascodePair|CurrentMirror|MillerRC|MillerRz|Ahuja|StrongArmLatch|PadDriver|Cap|Res|Ind)\\b"
        },
        {
          "match": "\\b(module|motif|trait)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.class.cascode" },
            "2": { "name": "entity.name.type.class.cascode" }
          }
        },
        {
          "match": "(:)\\s*([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.separator.type.cascode" },
            "2": { "name": "support.type.cascode" }
          }
        },
        {
          "match": "\\b(with|new)\\b\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.cascode" },
            "2": { "name": "support.class.motif.cascode" }
          }
        },
        {
          "match": "\\bfill\\s+([A-Za-z_][\\w]*)\\s+with\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "variable.other.instance.cascode" },
            "2": { "name": "support.class.motif.cascode" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "\\b(port|ports)\\b\\s*(in|out)?\\s*([A-Za-z_][\\w]*)",
          "captures": {
            "1": { "name": "keyword.other.declaration.cascode" },
            "2": { "name": "storage.modifier.direction.cascode" },
            "3": { "name": "entity.name.variable.port.cascode" }
          }
        },
        {
          "match": "\\bnet\\b\\s+([A-Za-z_][\\w]*)",
          "captures": { "1": { "name": "entity.name.variable.net.cascode" } }
        },
        {
          "match": "\\b([A-Za-z_][\\w]*)\\b\\s*=\\s*new\\b",
          "captures": { "1": { "name": "variable.other.instance.cascode" } }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.cascode",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.cascode",
          "match": "\\b(null|nil|None)\\b"
        },
        {
          "name": "support.constant.rail.cascode",
          "match": "\\b(VDD|GND)\\b"
        },
        {
          "name": "support.constant.process.cascode",
          "match": "\\b(TT|SS|FF)\\b"
        },
        {
          "name": "support.constant.device.cascode",
          "match": "\\b(NMOS|PMOS|pch|nch)\\b"
        },
        {
          "name": "support.constant.passive_kind.cascode",
          "match": "\\b(MIM|MOM|MFC|TFR|Poly|Metal|Pseudo|Spiral|MIMStack)\\b"
        },
        {
          "name": "constant.other.hint.cascode",
          "match": "\\b(Auto|X[0-9]+)\\b"
        },
        {
          "name": "variable.language.compensation.cascode",
          "match": "\\b(MillerRC|MillerRz|Ahuja)\\b"
        }
      ]
    }
  }
}
