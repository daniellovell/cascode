{
  "name": "cascode-lang",
  "displayName": "Cascode Language Support",
  "description": "Syntax highlighting and language support for Cascode (.cas) files",
  "version": "0.1.4",
  "publisher": "cascode",
  "repository": {
    "type": "git",
    "url": "https://github.com/cascode/cascode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:cascode"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cascode",
        "aliases": ["Cascode", "cascode", "cas"],
        "extensions": [".cas", ".cai"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cascode",
        "scopeName": "source.cascode",
        "path": "./syntaxes/cascode.tmLanguage.json"
      }
    ]
  }
}


