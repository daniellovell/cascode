VERSION 3.2

bundle Diff {
  // Terminals/nets inside bundles do NOT require
  // direction
  P : analog 
  N : analog
}

interface CurrentMirrorLike {
  input SENSE : analog
  output TAP[0] : analog
  connectors {
    to DiffPairLike {
      SENSE--OUT.N
      TAP[0]--OUT.P
    }
  }
}

interface DiffPairLike {
  output OUT : Diff
}
  



circuit OTA5T_Hierarchical implements SingleEndedOpAmp {
  level EL 
  supply VDD
  ground GND
  // Circuit terminals REQUIRE directionality
  // This is the special syntax for nets/terminals
  input IN : Diff
  output OUT : analog
  input VTAIL : bias
  fill {
    net mirror_gate : analog
    DiffPair dp = new DiffPair(InputPair=size(W=2u, L=180n, M=1), Tail=size(W=4u, L=180n, M=1)) {
      // We can separate by line AND comma, in arbitrary combinations
      .VDD--VDD, .GND--GND
      .IN--IN, .OUT.N--mirror_gate
      .OUT.P--OUT
      .TAIL--VTAIL
    }
    CurrentMirror cm = new CurrentMirror(Sense=size(W=2u, L=180n, M=1), ratio=1) {
      .VDD--VDD
      .GND--GND
      .SENSE--mirror_gate
      .TAP[0]--OUT
    }
    attach cm to dp via CurrentMirrorLike::DiffPairLike
  }
  constraints {
    bench {
      c_gbw = transfer_bench::GainBandwidth at net::OUT >= 20MHz
      c_gain = transfer_bench::PassbandGain at net::OUT >= 40dB
      c_pm = transfer_bench::PhaseMargin at net::OUT >= 60deg
      c_pwr = vdd_pwr::QuiescentPower <= 500uW
    }
  }
  harness {
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    load OUT C=1pF
  }

}
primitive Level1_NMOS(size primSize) implements NMOS {
  // Instantiate a level1 NMOS model which populates
  // the size parameters with the size tuple given
  device "level1_nmos"
  params {
    W = primSize.W
    L = primSize.L
    M = primSize.M
  }
}

primitive Level1_PMOS(size primSize) implements PMOS {
  // Instantiate a level1 PMOS model which populates
  // the size parameters with the size tuple given
  device "level1_pmos"
  params {
    W = primSize.W
    L = primSize.L
    M = primSize.M
  }
}

circuit DiffPair(size InputPair, size Tail) implements DiffPairLike {
  level EL
  inline
  supply VDD
  ground GND
  input IN : Diff 
  output OUT : Diff
  input TAIL : bias
  fill {
    net tnode : analog
    // 
    NMOS M_N = new Level1_NMOS(InputPair) {
      // We can do net bindings all on one line when
      // separated by comma
      .B--GND, .D--OUT.N, .G--IN.P, .S--tnode
    }
    NMOS M_P = new Level1_NMOS(InputPair) {
      .B--GND, .D--OUT.P, .G--IN.N, .S--tnode
    }

    NMOS M_TAIL = new Level1_NMOS(Tail) {
      .B--GND, .D--tnode, .G--TAIL, .S--GND
    }
  }
}

// Notice here how multi-line declaration was possible
// Convention is single-space indent for multi-line
circuit CurrentMirror(size Sense=size(W=2u, L=180n, M=1), int ratio=1) implements CurrentMirrorLike {
  level EL
  supply VDD
  ground GND
  input SENSE : analog
  output TAP[0] : analog

  fill {
    PMOS M_SENSE = new Level1_PMOS(Sense) {
      // Port bindings do not have to be comma-separated on one line
      // The comma separation is just a feature for brevity
      .B--VDD
      .D--SENSE
      .G--SENSE
      .S--VDD
    }

    size SenseMultiplied = size(Sense.W, Sense.L, Sense.M*ratio)

    PMOS M_TAP0 = new Level1_PMOS(SenseMultiplied) {
      // It is also legal for us to separate by line AND comma
      .B--VDD,
      .D--TAP[0],
      .G--SENSE,
      .S--VDD
    } 
  }
}
  
