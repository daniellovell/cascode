VERSION 5.0

bundle Diff {
  P : analog
  N : analog
}

interface CurrentMirrorLike {
  input SENSE : analog
  output TAP[0] : analog
  connectors {
    to DiffPairLike {
      SENSE--OUT.N
      TAP[0]--OUT.P
    }
  }
}

interface DiffPairLike {
  output OUT : Diff
}



primitive NMOS_Level1(size primSize) implements NMOS {
  device "nmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}

primitive PMOS_Level1(size primSize) implements PMOS {
  device "pmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}

circuit OTA5T_Hierarchical_Attach implements SingleEndedOpAmp {
  level EL
  supply VDD
  ground GND
  input IN : Diff
  output OUT : analog
  input VTAIL : bias
  fill {
    DiffPair dp = new DiffPair(InputPair=size(W=2u, L=180n, M=1), Tail=size(W=4u, L=180n, M=1)) {
      .GND--GND
      .VDD--VDD
      .IN--IN
      .OUT.P--OUT
      .TAIL--VTAIL
    }
    CurrentMirror cm = new CurrentMirror(ratio=1) {
      .GND--GND
      .VDD--VDD
      // TAP[0]--OUT intentionally omitted - covered by attach statement below
    }
    attach cm to dp via CurrentMirrorLike::DiffPairLike as mirror_node
  }
  constraints {
    bench {
      c_gbw = transfer_bench::GainBandwidth at net::OUT >= 20MHz
      c_gain = transfer_bench::PassbandGain at net::OUT >= 40dB
      c_pm = transfer_bench::PhaseMargin at net::OUT >= 60deg
      c_pwr = vdd_pwr::QuiescentPower <= 500uW
    }
  }
  harness {
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    load OUT C=1pF
  }
}

circuit DiffPair(size InputPair, size Tail) implements DiffPairLike {
  level EL
  inline
  supply VDD
  ground GND
  input IN : Diff
  output OUT : Diff
  input TAIL : bias
  fill {
    net tnode : analog
    NMOS M_N = new NMOS_Level1(InputPair) { .B--GND, .D--OUT.N, .G--IN.P, .S--tnode }
    NMOS M_P = new NMOS_Level1(InputPair) { .B--GND, .D--OUT.P, .G--IN.N, .S--tnode }
    NMOS M_TAIL = new NMOS_Level1(Tail) { .B--GND, .D--tnode, .G--TAIL, .S--GND }
  }
}

circuit CurrentMirror(size Sense=size(W=2u, L=180n, M=1), int ratio=1) implements CurrentMirrorLike {
  level EL
  supply VDD
  ground GND
  input SENSE : analog
  output TAP[0] : analog
  fill {
    PMOS M_SENSE = new PMOS_Level1(Sense) { .B--VDD, .D--SENSE, .G--SENSE, .S--VDD }
    size SenseMultiplied = size(Sense.W, Sense.L, Sense.M*ratio)
    PMOS M_TAP0 = new PMOS_Level1(SenseMultiplied) { .B--VDD, .D--TAP[0], .G--SENSE, .S--VDD }
  }
}
