VERSION 5.0

interface LoadBranch {
  input IN : analog
}

interface CurrentMirrorLike {
  input SENSE : analog
  output TAP[0] : analog
  connectors {
    to LoadBranch {
      TAP[0]--IN
    }
  }
}

primitive PMOS PMOS_Level1(size primSize) {
  device "pmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}

circuit CurrentMirror(size Sense=size(W=2u, L=180n, M=1), int ratio=1) implements CurrentMirrorLike {
  level EL
  supply VDD
  ground GND
  input SENSE : analog
  output TAP[0] : analog
  fill {
    PMOS M_SENSE = new PMOS_Level1(Sense) { .B--VDD, .D--SENSE, .G--SENSE, .S--VDD }
    size SenseMultiplied = size(Sense.W, Sense.L, Sense.M*ratio)
    PMOS M_TAP0 = new PMOS_Level1(SenseMultiplied) { .B--VDD, .D--TAP[0], .G--SENSE, .S--VDD }
  }
  constraints {
    tech {
      t_lmin : L >= 180nm on *
    }
  }
}
