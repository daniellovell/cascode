VERSION 4.1

bundle Diff {
  P : analog
  N : analog
}

interface DiffPairLike {
  output OUT : Diff
}

interface LoadPairLike {
  input BIAS : bias
  io DRAIN : Diff
  io SOURCE : Diff
  connectors {
    to DiffPairLike {
      DRAIN--OUT
    }
    to LoadPairLike {
      DRAIN--SOURCE
    }
  }
}



primitive NMOS NMOS_Level1(size primSize) {
  device "nmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}

primitive PMOS PMOS_Level1(size primSize) {
  device "pmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}

circuit TelescopicCascodeFullyDiff_Attach implements FullyDiffOpAmp {
  level EL
  supply VDD
  ground GND
  input IN : Diff
  output OUT : Diff
  input VBN : bias
  input VBP1 : bias
  input VBP2 : bias
  input VTAIL : bias
  fill {
    DiffPair dp = new DiffPair(InputPair=size(W=4u, L=500n, M=1), Tail=size(W=8u, L=500n, M=1)) { .GND--GND, .VDD--VDD }
    LoadPair_N nl = new LoadPair_N(Cascode=size(W=4u, L=500n, M=1)) { .GND--GND, .VDD--VDD }
    LoadPair_P pl1 = new LoadPair_P(Cascode=size(W=8u, L=500n, M=1)) { .GND--GND, .VDD--VDD }
    LoadPair_P pl2 = new LoadPair_P(Cascode=size(W=8u, L=500n, M=1)) { .GND--GND, .VDD--VDD }

    attach nl to dp via LoadPairLike::DiffPairLike as n_stack
    attach pl2 to pl1 to nl via LoadPairLike::LoadPairLike as p_stack

    dp.IN--IN
    dp.TAIL--VTAIL
    nl.BIAS--VBN
    nl.SOURCE--OUT
    pl1.BIAS--VBP1
    pl2.BIAS--VBP2
    pl2.SOURCE--VDD
  }
  constraints {
    numeric {
      c_gbw = transfer_bench::GainBandwidth >= 500kHz
      c_gain = transfer_bench::PassbandGain >= 2dB
      c_pm = transfer_bench::PhaseMargin >= 60deg
      c_pwr = vdd_pwr::QuiescentPower <= 1mW
    }
    tech {
      t_lmin : L >= 500nm on *
    }
  }
  harness {
    supply VDD = 1.8V
    bias VBN = 0.75V
    bias VBP1 = 1.0V
    bias VBP2 = 1.1V
    bias VTAIL = 0.7V
    load OUT (C=1pF || R=1G)
  }
}

circuit DiffPair(size InputPair, size Tail) implements DiffPairLike {
  level EL
  inline
  supply VDD
  ground GND
  input IN : Diff
  output OUT : Diff
  input TAIL : bias
  fill {
    net tnode : analog
    NMOS M_N = new NMOS_Level1(InputPair) { .B--GND, .D--OUT.P, .G--IN.P, .S--tnode }
    NMOS M_P = new NMOS_Level1(InputPair) { .B--GND, .D--OUT.N, .G--IN.N, .S--tnode }
    NMOS M_TAIL = new NMOS_Level1(Tail) { .B--GND, .D--tnode, .G--TAIL, .S--GND }
  }
}

circuit LoadPair_N(size Cascode) implements LoadPairLike {
  level EL
  inline
  supply VDD
  ground GND
  input BIAS : bias
  io DRAIN : Diff
  io SOURCE : Diff
  fill {
    NMOS M_P = new NMOS_Level1(Cascode) { .B--GND, .D--SOURCE.P, .G--BIAS, .S--DRAIN.P }
    NMOS M_N = new NMOS_Level1(Cascode) { .B--GND, .D--SOURCE.N, .G--BIAS, .S--DRAIN.N }
  }
}

circuit LoadPair_P(size Cascode) implements LoadPairLike {
  level EL
  inline
  supply VDD
  ground GND
  input BIAS : bias
  io DRAIN : Diff
  io SOURCE : Diff
  fill {
    PMOS M_P = new PMOS_Level1(Cascode) { .B--VDD, .D--DRAIN.P, .G--BIAS, .S--SOURCE.P }
    PMOS M_N = new PMOS_Level1(Cascode) { .B--VDD, .D--DRAIN.N, .G--BIAS, .S--SOURCE.N }
  }
}
