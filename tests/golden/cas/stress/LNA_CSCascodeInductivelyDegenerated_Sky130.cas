VERSION 5.0

include lib.std
include lib.pdk.sky130.devices.nfet_01v8
include lib.pdk.sky130.devices.pfet_01v8

circuit LNA_CSCascodeInductivelyDegenerated_Sky130 implements SingleEndedAmp {
  level EL

  supply VDD
  ground GND
  input IN : analog
  output OUT : analog

  fill {
    net nmatch : analog
    net ng : analog
    net nd : analog
    net ns : analog
    net ncas : analog
    net vcas : analog

    Inductor LM = new InductorIdeal(size(L=10n)) { .P--IN, .N--nmatch }
    Capacitor CM = new CapacitorIdeal(size(C=300f)) { .P--nmatch, .N--GND }
    Inductor LG = new InductorIdeal(size(L=32n)) { .P--nmatch, .N--ng }

    Inductor LS = new InductorIdeal(size(L=2.6n)) { .P--ns, .N--GND }
    Inductor LD = new InductorIdeal(size(L=5n)) { .P--VDD, .N--nd }

    Resistor RCAS_TOP = new ResistorIdeal(size(R=100k)) { .P--VDD, .N--vcas }
    Resistor RCAS_BOT = new ResistorIdeal(size(R=200k)) { .P--vcas, .N--GND }
    Capacitor CCAS = new CapacitorIdeal(size(C=20p)) { .P--vcas, .N--GND }

    NMOS M1 = new nfet_01v8(size(W=55u, L=180n, M=1)) { .D--ncas, .G--ng, .S--ns, .B--GND }
    NMOS M2 = new nfet_01v8(size(W=33u, L=180n, M=1)) { .D--nd, .G--vcas, .S--ncas, .B--GND }

    Capacitor COUT = new CapacitorIdeal(size(C=1p)) { .P--nd, .N--OUT }
  }

  env {
    InputCommonModeRange = 0.9V
    SourceImpedance = 50Ohm
    LoadImpedance = 50Ohm
  }

  constraints {
    bench {
      c_s21 = sparam_bench::S21(from=2.3GHz, to=2.5GHz) >= 12dB
      c_s11 = sparam_bench::S11(from=2.3GHz, to=2.5GHz) <= -15dB
      c_noise_figure = sparam_bench::NoiseFigure(from=2.3GHz, to=2.5GHz) <= 1dB
      c_vdd_pwr = vdd_pwr::QuiescentPower <= 4mW
    }
  }

  harness {
    supply VDD = 1.8V
    ground GND = 0V
  }
}
