VERSION 4.0

include lib.std


circuit RSeries_Sky130 {
  level EL

  input IN : analog
  output OUT : analog
  ground GND

  env {
    InputCommonModeRange = 0V
    OutputCommonModeRange = 0V
  }

  fill {
    Resistor R1 = new Ideal_Resistor(size(R=100)) {
      .P--IN
      .N--OUT
    }
  }

  benches {
    bind TwoPortSParam as sparam {
      bench.P1--dut.IN
      bench.P2--dut.OUT
    }
  }

  constraints {
    numeric {
      c_input_return_loss = sparam::InputReturnLoss(f=1MHz) == 6.02059991328dB
      c_forward_gain = sparam::ForwardGain(f=1MHz) == -6.02059991328dB
      // The network is reciprocal.
      c_output_return_loss = sparam::OutputReturnLoss(f=1MHz) == 6.02059991328dB
      c_reverse_isolation = sparam::ReverseIsolation(f=1MHz) == 6.02059991328dB
    }
  }
}
