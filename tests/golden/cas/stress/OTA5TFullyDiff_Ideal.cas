VERSION 5.0

// Stress test: fully-differential 5T OTA using generic Level-1 devices (no PDK needed).
//
// Primary purpose: exercise Diff->Diff bench binding and validate differential load impedance
// splitting (LoadImpedance.DiffToShunt()) in the standard transfer bench.

include lib.std

circuit OTA5TFullyDiff_Ideal implements FullyDifferentialOpAmp {
  level EL
  supply VDD
  ground GND
  input IN : Diff
  output OUT : Diff
  input VTAIL : bias

  env {
    InputCommonModeRange = 0.9V
    SourceImpedance = 50Ohm
    // Differential target load. Diff benches split this to per-side shunts via DiffToShunt().
    LoadImpedance = (1GOhm || 15pF)
  }

  fill {
    net tnode : analog
    net vcm_node : analog

    NMOS M_N = new NMOSLevel1(size(W=2u, L=180n, M=1)) {
      .B--GND
      .D--OUT.P
      .G--IN.N
      .S--tnode
    }

    NMOS M_P = new NMOSLevel1(size(W=2u, L=180n, M=1)) {
      .B--GND
      .D--OUT.N
      .G--IN.P
      .S--tnode
    }

    NMOS M_TAIL = new NMOSLevel1(size(W=4u, L=180n, M=1)) {
      .B--GND
      .D--tnode
      .G--VTAIL
      .S--GND
    }

    PMOS M_LOAD_P = new PMOSLevel1(size(W=2u, L=180n, M=1)) {
      .B--VDD
      .D--OUT.P
      .G--vcm_node
      .S--VDD
    }

    PMOS M_LOAD_N = new PMOSLevel1(size(W=2u, L=180n, M=1)) {
      .B--VDD
      .D--OUT.N
      .G--vcm_node
      .S--VDD
    }

    Resistor R_CMFB_P = new ResistorIdeal(size(R=500k)) {
      .P--OUT.P
      .N--vcm_node
    }

    Resistor R_CMFB_N = new ResistorIdeal(size(R=500k)) {
      .P--OUT.N
      .N--vcm_node
    }
  }

  constraints {
    numeric {
      c_gbw = transfer_bench::GainBandwidth at net::OUT >= 10MHz
      c_gain = transfer_bench::PassbandGain at net::OUT >= 15dB
      c_cmrr = cmrr_bench::CMRR at net::OUT >= 300dB
      c_int_noise = noise_bench::IntegratedInputNoise(from=10Hz, to=10MHz) <= 10uVrms
      c_pm = transfer_bench::PhaseMargin at net::OUT >= 45deg
      c_vdd_pwr = vdd_pwr::QuiescentPower <= 10mW
      c_output_swing = tran_bench(stim_freq=1kHz)::OutputSwing() at net::OUT >= 0.2V
      c_psrr = psrr_bench::PSRR at net::OUT >= 20dB
      c_input_psrr = psrr_bench::InputReferredPSRR at net::OUT >= 20dB
    }
  }

  harness {
    supply VDD = 1.8V
    ground GND = 0V
    bias VTAIL = 0.6V
  }
}
