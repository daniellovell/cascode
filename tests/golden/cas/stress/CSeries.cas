VERSION 4.0

include lib.std


circuit CSeries_Sky130 {
  level EL

  input IN : analog
  output OUT : analog
  ground GND

  env {
    InputCommonModeRange = 0V
    OutputCommonModeRange = 0V
  }

  fill {
    Capacitor C1 = new Ideal_Capacitor(size(C=3.18309886184n)) {
      .P--IN
      .N--OUT
    }
  }

  benches {
    bind TwoPortSParamNoise as sparam_bench {
      bench.P1--dut.IN
      bench.P2--dut.OUT
    }
  }

  constraints {
    numeric {
      // The capacitor impedance is 50Ohm at 1MHz.
      c_input_return_loss_low = sparam_bench::InputReturnLoss(f=100kHz) <= 0.2dB
      c_input_return_loss_50_min = sparam_bench::InputReturnLoss(f=1MHz) >= 6.98dB
      c_input_return_loss_50_max = sparam_bench::InputReturnLoss(f=1MHz) <= 6.99dB
      c_input_return_loss_high = sparam_bench::InputReturnLoss(f=10MHz) >= 26dB
      c_forward_gain_min = sparam_bench::ForwardGain(f=1MHz) >= -0.97dB
      c_forward_gain_max = sparam_bench::ForwardGain(f=1MHz) <= -0.96dB
      // The network is reciprocal.
      c_output_return_loss_low = sparam_bench::OutputReturnLoss(f=100kHz) <= 0.2dB
      c_output_return_loss_50_min = sparam_bench::OutputReturnLoss(f=1MHz) >= 6.98dB
      c_output_return_loss_50_max = sparam_bench::OutputReturnLoss(f=1MHz) <= 6.99dB
      c_output_return_loss_high = sparam_bench::OutputReturnLoss(f=10MHz) >= 26dB
      c_reverse_isolation_min = sparam_bench::ReverseIsolation(f=1MHz) >= 0.96dB
      c_reverse_isolation_max = sparam_bench::ReverseIsolation(f=1MHz) <= 0.97dB
      c_noise_figure = sparam_bench::NoiseFigure(f=1MHz) == 0dB
      c_min_noise_figure = sparam_bench::MinNoiseFigure(f=1MHz) == 0dB
      c_noise_resistance = sparam_bench::NoiseResistance(f=1MHz) == 0Ohm
    }
  }
}
