VERSION 5.0

primitive ResistorIdeal(size primSize) implements Resistor {
  device "resistor"
  params {
    R = primSize.R
  }
}

primitive NMOS_Level1(size primSize) implements NMOS {
  device "nmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


circuit CSAmpResistive implements SingleEndedAmp {
  level EL
  supply VDD
  ground GND
  input IN : analog
  output OUT : analog
  fill {
    NMOS M_in = new NMOS_Level1(size(W=10u, L=180n, M=1)) {
      .D--OUT
      .G--IN
      .S--GND
      .B--GND
    }
    Resistor R_load = new ResistorIdeal(size(R=10k)) {
      .P--VDD
      .N--OUT
    }
  }
  constraints {
    bench {
      c_gbw = transfer_bench::GainBandwidth at net::OUT >= 10MHz
      c_gain = transfer_bench::PassbandGain at net::OUT >= 20dB
    }
  }
  harness {
    supply VDD = 1.8V
    load OUT C=1pF
  }
}
