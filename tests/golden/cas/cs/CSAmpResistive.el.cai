VERSION 3.1

primitive Resistor Ideal_Resistor(size primSize) {
  device "resistor"
  params {
    R = primSize.R
  }
}

primitive NMOS Level1_NMOS(size primSize) {
  device "level1_nmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


circuit CSAmpResistive implements SingleEndedAmp {
  level EL
  supply VDD
  ground GND
  input IN : analog
  output OUT : analog
  fill {
    NMOS M_in = new Level1_NMOS(size(W=10u, L=180n, M=1)) {
      .D--OUT
      .G--IN
      .S--GND
      .B--GND
    }
    Resistor R_load = new Ideal_Resistor(size(R=10k)) {
      .P--VDD
      .N--OUT
    }
  }
  constraints {
    numeric {
      c_gbw = ACBench::GainBandwidth at net::OUT >= 10MHz
      c_gain = ACBench::PassbandGain at net::OUT >= 20dB
    }
  }
  harness {
    supply VDD = 1.8V
    load OUT C=1pF
  }
}
