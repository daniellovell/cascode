VERSION 3.1

primitive NMOS nfet_01v8(size primSize) {
  device "sky130_fd_pr__nfet_01v8"
  params {
    w = primSize.W
    l = primSize.L
    mult = primSize.M
  }
}

primitive PMOS pfet_01v8(size primSize) {
  device "sky130_fd_pr__pfet_01v8"
  params {
    w = primSize.W
    l = primSize.L
    mult = primSize.M
  }
}


circuit CommonSourceAmp_Pdk implements SingleEndedAmp {
  level EL
  supply VDD
  ground GND
  input IN : analog
  output OUT : analog
  input VBIAS : bias
  fill {
    NMOS M_in = new nfet_01v8(size(W=10u, L=180n, M=1)) {
      .D--OUT
      .G--IN
      .S--GND
      .B--GND
    }
    PMOS load.M = new pfet_01v8(size(W=20u, L=180n, M=1)) {
      .D--OUT
      .G--VBIAS
      .S--VDD
      .B--VDD
    }
  }
  constraints {
    numeric {
      c_gbw = ACBench::GainBandwidth at net::OUT >= 50MHz
      c_gain = ACBench::PassbandGain at net::OUT >= 30dB
    }
  }
  harness {
    supply VDD = 1.8V
    bias VBIAS = 0.7V
    load OUT C=1pF
  }
}
