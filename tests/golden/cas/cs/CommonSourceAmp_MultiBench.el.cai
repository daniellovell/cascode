VERSION 5.0


circuit CommonSourceAmp_MultiBench implements SingleEndedAmp {
  level EL
  supply VDD
  ground GND
  input IN : analog
  output OUT : analog
  input VBIAS : bias
  fill {
    NMOS M_in = new NMOS_Level1(size(W=10u, L=180n, M=1)) {
      .D--OUT
      .G--IN
      .S--GND
      .B--GND
    }
    PMOS load.M = new PMOS_Level1(size(W=20u, L=180n, M=1)) {
      .D--OUT
      .G--VBIAS
      .S--VDD
      .B--VDD
    }
  }
  constraints {
    bench {
      c_gbw = transfer_bench::GainBandwidth at net::OUT >= 1kHz
      c_gain = transfer_bench::PassbandGain at net::OUT >= 0dB
      c_out_bias = dc_bias::OutputDCBias at net::OUT >= 0V
      c_power = vdd_pwr::QuiescentPower <= 1W
    }
  }
  harness {
    supply VDD = 1.8V
    bias VBIAS = 0.7V
    load OUT C=1pF
  }
}
