VERSION 5.0

primitive NMOS_Level1(size primSize) implements NMOS {
  device "nmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}

primitive PMOS_Level1(size primSize) implements PMOS {
  device "pmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


circuit CommonSourceAmp implements SingleEndedAmp {
  level EL
  supply VDD
  ground GND
  input IN : analog
  output OUT : analog
  input VBIAS : bias
  fill {
    NMOS M_in = new NMOS_Level1(size(W=10u, L=180n, M=1)) {
      .D--OUT
      .G--IN
      .S--GND
      .B--GND
    }
    PMOS load.M = new PMOS_Level1(size(W=20u, L=180n, M=1)) {
      .D--OUT
      .G--VBIAS
      .S--VDD
      .B--VDD
    }
  }
  constraints {
    bench {
      c_gbw = transfer_bench::GainBandwidth at net::OUT >= 50MHz
      c_gain = transfer_bench::PassbandGain at net::OUT >= 30dB
    }
  }
  harness {
    supply VDD = 1.8V
    bias VBIAS = 0.7V
    load OUT C=1pF
  }
}
