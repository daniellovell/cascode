VERSION 4.0

primitive Resistor ResistorIdeal(size primSize) {
  device "resistor"
  params {
    R = primSize.R
  }
}

primitive NMOS NMOS_Level1(size primSize) {
  device "nmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


circuit CSAmpResistive_DCSwept implements SingleEndedAmp {
  level EL
  supply VDD
  ground GND
  input IN : analog
  output OUT : analog
  fill {
    NMOS M_in = new NMOS_Level1(size(W=10u, L=180n, M=1)) {
      .D--OUT
      .G--IN
      .S--GND
      .B--GND
    }
    Resistor R_load = new ResistorIdeal(size(R=10k)) {
      .P--VDD
      .N--OUT
    }
  }
  constraints {
    numeric {
      c_out_bias = dc_bias::OutputDCBias at net::OUT >= 0.4V
      c_power = vdd_pwr::QuiescentPower <= 500uW
    }
  }
  harness {
    supply VDD = 1.8V
    sweep InputDCBias [0.3V:100mV:1.5V]
    load OUT C=1pF
  }
}
