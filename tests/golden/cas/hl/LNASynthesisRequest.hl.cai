VERSION 4.0

include lib.std

circuit LNASynthesisRequest implements SingleEndedAmp {
  level HL

  supply VDD
  ground GND
  input IN : analog
  output OUT : analog

  slot

  env {
    InputCommonModeRange = 0.9V
    SourceImpedance = 50Ohm
    LoadImpedance = 50Ohm
  }

  constraints {
    numeric {
      c_s21 = sparam_bench::S21(from=2.3GHz, to=2.5GHz) >= 10dB
      c_s11 = sparam_bench::S21(from=2.3GHz, to=2.5GHz) <= -15dB
      c_noise_figure = sparam_bench::NoiseFigure(from=2.3GHz, to=2.5GHz) <= 3dB
      c_vdd_pwr = vdd_pwr::QuiescentPower <= 8mW
    }
  }

  harness {
    supply VDD = 1.8V
    ground GND = 0V
  }

  synth {
    seed = 42
    objective = minimize_power
  }
}
