VERSION 4.0

primitive NMOS NMOS_Level1(size primSize) {
  device "nmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}

primitive PMOS PMOS_Level1(size primSize) {
  device "pmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


bundle Diff {
  P : analog
  N : analog

}
circuit OTA5TSingleEnded_DCSwept implements SingleEndedOpAmp {
  level EL
  supply VDD
  ground GND
  input IN : Diff
  output OUT : analog
  input VTAIL : bias
  fill {
    net mirror_gate : analog
    net tnode : analog
    NMOS dp.M_N = new NMOS_Level1(size(W=2u, L=180n, M=1)) {
      .B--GND
      .D--mirror_gate
      .G--IN.P
      .S--tnode
    }
    NMOS dp.M_P = new NMOS_Level1(size(W=2u, L=180n, M=1)) {
      .B--GND
      .D--OUT
      .G--IN.N
      .S--tnode
    }
    NMOS dp.M_TAIL = new NMOS_Level1(size(W=4u, L=180n, M=1)) {
      .B--GND
      .D--tnode
      .G--VTAIL
      .S--GND
    }
    PMOS cm.M_SENSE = new PMOS_Level1(size(W=2u, L=180n, M=1)) {
      .B--VDD
      .D--mirror_gate
      .G--mirror_gate
      .S--VDD
    }
    PMOS cm.M_TAP0 = new PMOS_Level1(size(W=2u, L=180n, M=1)) {
      .B--VDD
      .D--OUT
      .G--mirror_gate
      .S--VDD
    }
  }
  constraints {
    numeric {
      c_out_bias = dc_bias::OutputDCBias at net::OUT >= 0.4V
      c_power = vdd_pwr::QuiescentPower <= 500uW
    }
  }
  harness {
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    sweep InputDCCommonMode [0.4V:100mV:1.4V]
    load OUT C=1pF
  }
}
