VERSION 4.0

primitive Resistor ResistorIdeal(size primSize) {
  device "resistor"
  params {
    R = primSize.R
  }
}

primitive NMOS NMOS_Level1(size primSize) {
  device "nmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}

primitive PMOS PMOS_Level1(size primSize) {
  device "pmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


bundle Diff {
  P : analog
  N : analog

}
circuit OTA5TFullyDiff_DCSwept implements FullyDiffOpAmp {
  level EL
  supply VDD
  ground GND
  input IN : Diff
  output OUT : Diff
  input VTAIL : bias
  fill {
    net tnode : analog
    net vcm_node : analog
    NMOS dp.M_N = new NMOS_Level1(size(W=2u, L=180n, M=1)) {
      .B--GND
      .D--OUT.P
      .G--IN.P
      .S--tnode
    }
    NMOS dp.M_P = new NMOS_Level1(size(W=2u, L=180n, M=1)) {
      .B--GND
      .D--OUT.N
      .G--IN.N
      .S--tnode
    }
    NMOS dp.M_TAIL = new NMOS_Level1(size(W=4u, L=180n, M=1)) {
      .B--GND
      .D--tnode
      .G--VTAIL
      .S--GND
    }
    PMOS M_LOAD_P = new PMOS_Level1(size(W=2u, L=180n, M=1)) {
      .B--VDD
      .D--OUT.P
      .G--vcm_node
      .S--VDD
    }
    PMOS M_LOAD_N = new PMOS_Level1(size(W=2u, L=180n, M=1)) {
      .B--VDD
      .D--OUT.N
      .G--vcm_node
      .S--VDD
    }
    Resistor R_CMFB_P = new ResistorIdeal(size(R=500k)) {
      .P--OUT.P
      .N--vcm_node
    }
    Resistor R_CMFB_N = new ResistorIdeal(size(R=500k)) {
      .P--OUT.N
      .N--vcm_node
    }
  }
  constraints {
    numeric {
      c_out_cm_min = dc_bias::OutputDCCommonMode >= 0.3V
      c_out_cm_max = dc_bias::OutputDCCommonMode <= 1.5V
      c_power = vdd_pwr::QuiescentPower <= 800uW
    }
  }
  harness {
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    sweep InputDCCommonMode [0.4V:100mV:1.4V]
    load OUT C=1pF
  }
}
