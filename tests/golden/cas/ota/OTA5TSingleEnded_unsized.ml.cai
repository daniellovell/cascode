VERSION 3.2

primitive Level1_NMOS(size primSize) implements NMOS {
  device "level1_nmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}

primitive Level1_PMOS(size primSize) implements PMOS {
  device "level1_pmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


// ML-level (unsized) version of OTA5TSingleEnded
// Same topology as EL version but with ?? placeholders for sizing

bundle Diff {
  P : analog
  N : analog

}
circuit OTA5TSingleEnded implements SingleEndedOpAmp {
  level ML
  supply VDD
  ground GND
  input IN : Diff
  output OUT : analog
  input VTAIL : bias
  fill {
    net mirror_gate : analog
    net tnode : analog
    NMOS dp.M_N = new Level1_NMOS(size(W=??, L=??, M=??)) {
      .B--GND
      .D--mirror_gate
      .G--IN.P
      .S--tnode
    }
    NMOS dp.M_P = new Level1_NMOS(size(W=??, L=??, M=??)) {
      .B--GND
      .D--OUT
      .G--IN.N
      .S--tnode
    }
    NMOS dp.M_TAIL = new Level1_NMOS(size(W=??, L=??, M=??)) {
      .B--GND
      .D--tnode
      .G--VTAIL
      .S--GND
    }
    PMOS cm.M_SENSE = new Level1_PMOS(size(W=??, L=??, M=??)) {
      .B--VDD
      .D--mirror_gate
      .G--mirror_gate
      .S--VDD
    }
    PMOS cm.M_TAP0 = new Level1_PMOS(size(W=??, L=??, M=??)) {
      .B--VDD
      .D--OUT
      .G--mirror_gate
      .S--VDD
    }
  }
  constraints {
    bench {
      c_gbw = transfer_bench::GainBandwidth at net::OUT >= 20MHz
      c_gain = transfer_bench::PassbandGain at net::OUT >= 40dB
      c_pm = transfer_bench::PhaseMargin at net::OUT >= 60deg
      c_pwr = vdd_pwr::QuiescentPower <= 500uW
    }
    physical {
      t_lmin : L >= 180nm on *
    }
  }
  harness {
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    load OUT C=1pF
  }
}
