VERSION 5.0

primitive NMOS_Level1(size primSize) implements NMOS {
  device "nmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}

primitive PMOS_Level1(size primSize) implements PMOS {
  device "pmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


bundle Diff {
  P : analog
  N : analog

}
circuit OTA5TSingleEnded implements SingleEndedOpAmp {
  level EL
  supply VDD
  ground GND
  input IN : Diff
  output OUT : analog
  input VTAIL : bias
  fill {
    net mirror_gate : analog
    net tnode : analog
    NMOS dp.M_N = new NMOS_Level1(size(W=2u, L=180n, M=1)) {
      .B--GND
      .D--mirror_gate
      .G--IN.P
      .S--tnode
    }
    NMOS dp.M_P = new NMOS_Level1(size(W=2u, L=180n, M=1)) {
      .B--GND
      .D--OUT
      .G--IN.N
      .S--tnode
    }
    NMOS dp.M_TAIL = new NMOS_Level1(size(W=4u, L=180n, M=1)) {
      .B--GND
      .D--tnode
      .G--VTAIL
      .S--GND
    }
    PMOS cm.M_SENSE = new PMOS_Level1(size(W=2u, L=180n, M=1)) {
      .B--VDD
      .D--mirror_gate
      .G--mirror_gate
      .S--VDD
    }
    PMOS cm.M_TAP0 = new PMOS_Level1(size(W=2u, L=180n, M=1)) {
      .B--VDD
      .D--OUT
      .G--mirror_gate
      .S--VDD
    }
  }
  constraints {
    bench {
      c_gbw = transfer_bench::GainBandwidth at net::OUT >= 20MHz
      c_gain = transfer_bench::PassbandGain at net::OUT >= 40dB
      c_pm = transfer_bench::PhaseMargin at net::OUT >= 60deg
      c_pwr = vdd_pwr::QuiescentPower <= 500uW
      c_swing = tran_bench(stim_freq=1kHz)::OutputSwing() at net::OUT >= 1.2Vpp
    }
    physical {
      t_lmin : L >= 180nm on *
    }
  }
  harness {
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    load OUT C=1pF
  }
}
