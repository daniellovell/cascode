VERSION 3.2

primitive Resistor Ideal_Resistor(size primSize) {
  device "resistor"
  params {
    R = primSize.R
  }
}

primitive NMOS Level1_NMOS(size primSize) {
  device "level1_nmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}

primitive PMOS Level1_PMOS(size primSize) {
  device "level1_pmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


bundle Diff {
  P : analog
  N : analog

}
circuit OTA5TFullyDiff implements FullyDiffOpAmp {
  level EL
  supply VDD
  ground GND
  input IN : Diff
  output OUT : Diff
  input VTAIL : bias
  fill {
    net tnode : analog
    net vcm_node : analog
    NMOS dp.M_N = new Level1_NMOS(size(W=2u, L=180n, M=1)) {
      .B--GND
      .D--OUT.P
      .G--IN.P
      .S--tnode
    }
    NMOS dp.M_P = new Level1_NMOS(size(W=2u, L=180n, M=1)) {
      .B--GND
      .D--OUT.N
      .G--IN.N
      .S--tnode
    }
    NMOS dp.M_TAIL = new Level1_NMOS(size(W=4u, L=180n, M=1)) {
      .B--GND
      .D--tnode
      .G--VTAIL
      .S--GND
    }
    PMOS M_LOAD_P = new Level1_PMOS(size(W=2u, L=180n, M=1)) {
      .B--VDD
      .D--OUT.P
      .G--vcm_node
      .S--VDD
    }
    PMOS M_LOAD_N = new Level1_PMOS(size(W=2u, L=180n, M=1)) {
      .B--VDD
      .D--OUT.N
      .G--vcm_node
      .S--VDD
    }
    Resistor R_CMFB_P = new Ideal_Resistor(size(R=500k)) {
      .P--OUT.P
      .N--vcm_node
    }
    Resistor R_CMFB_N = new Ideal_Resistor(size(R=500k)) {
      .P--OUT.N
      .N--vcm_node
    }
  }
  constraints {
    numeric {
      c_gbw = ACBench::GainBandwidth >= 20MHz
      c_gain = ACBench::PassbandGain >= 30dB
      c_pm = ACBench::PhaseMargin >= 60deg
      c_pwr = DCBench::QuiescentPower <= 800uW
      c_swing = TranBench::DifferentialOutputSwing >= 1.2Vpp
    }
    tech {
      t_lmin : L >= 180nm on *
    }
  }
  harness {
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    load OUT C=1pF
  }
}
