package analog.ota; import lib.std.amp.*; import lib.std.prim.*;

// Fully differential 5-transistor OTA with resistive self-biased CMFB.
// DiffPair + PMOS loads with gates tied to averaged output via resistive divider.
// Synthesizable structural motif (no spec/bench blocks here).
motif OTA5TFullyDiff implements FullyDiffOpAmp {
  supply VDD = 1.8V; ground GND;

  // Public interface (ALL CAPS ports; Diff bundle fields are P/N).
  ports [ IN: Diff, OUT: Diff, VTAIL: bias ]

  use {
    // Differential pair with internal tail. Base at ground; bias is VTAIL.
    dp = new DiffPair { p=NMOS; hasTail=true } {
      IN.P -> IN.P; IN.N -> IN.N; BASE -> GND; BIAS -> VTAIL;
    };

    // PMOS load devices (not using CurrentMirror since gates tied to VCM, not diode-connected).
    // M_LOAD_P loads the P output (dp.OUT.P).
    M_LOAD_P = new MOS(PMOS) { drain -> dp.OUT.P; gate -> vcm_node; source -> VDD; };
    // M_LOAD_N loads the N output (dp.OUT.N).
    M_LOAD_N = new MOS(PMOS) { drain -> dp.OUT.N; gate -> vcm_node; source -> VDD; };

    // Resistive CMFB network: large resistors average the differential outputs at vcm_node.
    R_CMFB_P = new Resistor { r = 500k } { p1 -> dp.OUT.P; p2 -> vcm_node; };
    R_CMFB_N = new Resistor { r = 500k } { p1 -> dp.OUT.N; p2 -> vcm_node; };

    // Fully differential outputs.
    connect dp.OUT.P -> OUT.P;
    connect dp.OUT.N -> OUT.N;
  }
}

