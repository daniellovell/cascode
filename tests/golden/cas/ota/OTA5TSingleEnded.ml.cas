VERSION 3.0

bundle Diff {
  N : analog
  P : analog
}

circuit OTA5TSingleEnded implements SingleEndedOpAmp {
  level ML
  supply VDD
  ground GND
  input IN : Diff
  output OUT : analog
  input VTAIL : bias
  fill {
    cm = new CurrentMirror {
    }
    dp = new DiffPair {
      .BASE--GND
      .BIAS--VTAIL
      .IN.N--IN.N
      .IN.P--IN.P
      .OUT.N--OUT
    }
  }
}
