VERSION 3.0

primitive resistor Ideal_Resistor(size primSize) {
  device "resistor"
  params {
    R = primSize.R
  }
}

primitive nmos Level1_NMOS(size primSize) {
  device "level1_nmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}

primitive pmos Level1_PMOS(size primSize) {
  device "level1_pmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


bundle Diff {
  P : analog
  N : analog

}
circuit OTA5TFullyDiff_DCSwept implements FullyDiffOpAmp {
  level EL
  supply VDD
  ground GND
  input IN : Diff
  output OUT : Diff
  input VTAIL : bias
  fill {
    net tnode : analog
    net vcm_node : analog
    nmos dp.M_N = new Level1_NMOS(size(W=2u, L=180n, M=1)) {
      .B--GND
      .D--OUT.P
      .G--IN.P
      .S--tnode
    }
    nmos dp.M_P = new Level1_NMOS(size(W=2u, L=180n, M=1)) {
      .B--GND
      .D--OUT.N
      .G--IN.N
      .S--tnode
    }
    nmos dp.M_TAIL = new Level1_NMOS(size(W=4u, L=180n, M=1)) {
      .B--GND
      .D--tnode
      .G--VTAIL
      .S--GND
    }
    pmos M_LOAD_P = new Level1_PMOS(size(W=2u, L=180n, M=1)) {
      .B--VDD
      .D--OUT.P
      .G--vcm_node
      .S--VDD
    }
    pmos M_LOAD_N = new Level1_PMOS(size(W=2u, L=180n, M=1)) {
      .B--VDD
      .D--OUT.N
      .G--vcm_node
      .S--VDD
    }
    resistor R_CMFB_P = new Ideal_Resistor(size(R=500k)) {
      .P--OUT.P
      .N--vcm_node
    }
    resistor R_CMFB_N = new Ideal_Resistor(size(R=500k)) {
      .P--OUT.N
      .N--vcm_node
    }
  }
  constraints {
    numeric {
      c_out_cm_min = DCBench::OutputDCCommonMode_min >= 0.3V
      c_out_cm_max = DCBench::OutputDCCommonMode_max <= 1.5V
      c_power = DCBench::QuiescentPower <= 800uW
    }
  }
  harness {
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    sweep InputDCCommonMode [0.4V:100mV:1.4V]
    load OUT C=1pF
  }
}
