VERSION 4.1

include lib.std

bench TranBench {
  stim IN : analog

  analysis {
    TranAnalysis tr = new TranAnalysis(stop=2us, step=2ns)
  }

  measurements {
    measurement InternalNodePeak : V {
      VoltageWaveform v = voltage(tr, dut.n)
      return v.Max()
    }

    measurement SupplyCurrentPeak : A {
      CurrentWaveform i = current(tr, harness.VDD.P)
      return i.Max()
    }
  }
}

circuit TranInternalCurrent {
  level EL
  supply VDD
  ground GND
  input IN : analog

  benches {
    bind TranBench as tran {
      bench.IN--dut.IN
      VSIN vin = new VSIN(DC=0V, A=100mV, freq=1MHz) { .P--IN, .N--dut.GND }
    }
  }

  constraints {
    numeric {
      c_internal = tran::InternalNodePeak >= 0V
      c_supply = tran::SupplyCurrentPeak >= 0A
    }
  }

  harness {
    supply VDD = 1.8V
    ground GND = 0V
  }

  fill {
    net n : analog
    Resistor R1 = new ResistorIdeal(size(R=10k)) { .P--VDD, .N--n }
    Resistor R2 = new ResistorIdeal(size(R=10k)) { .P--IN, .N--n }
    Capacitor C1 = new CapacitorIdeal(size(C=1n)) { .P--n, .N--GND }
  }
}
