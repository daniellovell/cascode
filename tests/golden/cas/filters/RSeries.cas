VERSION 5.0

include lib.std


circuit RSeriesQ implements SingleEndedPassiveFilter {
  level EL

  input IN : analog
  output OUT : analog
  ground GND

  env {
    InputCommonModeRange = 0V
    OutputCommonModeRange = 0V
  }

  fill {
    Resistor R1 = new ResistorIdeal(size(R=100)) {
      .P--IN
      .N--OUT
    }
  }

  constraints {
    bench {
      c_s11 = sparam_bench::S11(f=1MHz) == -6.02059991328dB
      c_input_return_loss = sparam_bench::InputReturnLoss(f=1MHz) == 6.02059991328dB
      c_s21 = sparam_bench::S21(f=1MHz) == -6.02059991328dB
      c_forward_gain = sparam_bench::ForwardGain(f=1MHz) == -6.02059991328dB
      // The network is reciprocal.
      c_s22 = sparam_bench::S22(f=1MHz) == -6.02059991328dB
      c_output_return_loss = sparam_bench::OutputReturnLoss(f=1MHz) == 6.02059991328dB
      c_s12 = sparam_bench::S12(f=1MHz) == -6.02059991328dB
      c_reverse_isolation = sparam_bench::ReverseIsolation(f=1MHz) == 6.02059991328dB
      c_noise_resistance = sparam_bench::NoiseResistance(f=1MHz) == 100Ohm
    }
  }
}
