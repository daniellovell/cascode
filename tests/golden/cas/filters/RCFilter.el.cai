VERSION 5.0

primitive CapacitorIdeal(size primSize) implements Capacitor {
  device "capacitor"
  params {
    C = primSize.C
  }
}

primitive ResistorIdeal(size primSize) implements Resistor {
  device "resistor"
  params {
    R = primSize.R
  }
}

circuit RCFilter implements SingleEndedPassiveFilter {
  level EL
  ground GND
  input IN : analog
  output OUT : analog
  fill {
    Capacitor C1 = new CapacitorIdeal(size(C=1p)) {
      .N--GND
      .P--OUT
    }
    Resistor R1 = new ResistorIdeal(size(R=1k)) {
      .N--OUT
      .P--IN
    }
  }
}
