// Linked golden for complete-document contract enforcement.
// Exercise this file with `cascode emit` and `cascode erc` regressions to verify
// that linked `.cai` artifacts retain `implements`, the referenced interface, and declared terminals.

VERSION 4.1

bundle Diff {
  N : analog
  P : analog
}

interface DifferentialPassiveFilter {
  ground GND
  input IN.N : analog
  input IN.P : analog
  output OUT.N : analog
  output OUT.P : analog
}

primitive Capacitor CapacitorIdeal(size primSize) {
  device "capacitor"
  params {
    C = primSize.C
  }
}

primitive Resistor ResistorIdeal(size primSize) {
  device "resistor"
  params {
    R = primSize.R
  }
}

circuit DiffRCFilter implements DifferentialPassiveFilter {
  level EL
  ground GND
  input IN.N : analog
  input IN.P : analog
  output OUT.N : analog
  output OUT.P : analog
  fill {
    Capacitor C_DIFF = new CapacitorIdeal(size(C=1p)) {
      .N--OUT.N
      .P--OUT.P
    }
    Resistor R_N = new ResistorIdeal(size(R=10k)) {
      .N--OUT.N
      .P--IN.N
    }
    Resistor R_P = new ResistorIdeal(size(R=10k)) {
      .N--OUT.P
      .P--IN.P
    }
  }
}
