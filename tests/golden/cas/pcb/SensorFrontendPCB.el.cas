VERSION 5.0

include tests.golden.cas.pcb.sensor_frontend.components

// Definitive EL example: the board schematic is fully concrete at this hierarchy.
circuit SensorFrontendPCB {
  level EL
  supply VDD_3V3
  ground GND
  input SENSOR : Diff
  output DEBUG : UART
  io PROG : SWD

  fill {
    net conditioned : analog
    net i2c_bus : I2C
    net drdy : digital

    ADCStage adc = new ADCStage() {
      .VDD--VDD_3V3
      .GND--GND
      .AIN--conditioned
      .BUS--i2c_bus
      .DRDY--drdy
    }

    WheatstoneAmplifier frontend = new WheatstoneAmplifier(load_cap=adc.InputCapacitance) {
      .VDD--VDD_3V3
      .GND--GND
      .SENSOR_IN--SENSOR
      .SIGNAL_OUT--conditioned
    }

    Controller mcu = new Controller() {
      .VDD--VDD_3V3
      .GND--GND
      .PERIPH--i2c_bus
      .IRQ--drdy
      .DEBUG--DEBUG
      .PROG--PROG
    }
  }

  harness {
    supply VDD_3V3 = 3.3V
    ground GND = 0V
  }
}
