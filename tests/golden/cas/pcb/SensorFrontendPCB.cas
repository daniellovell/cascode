VERSION 3.1

// Sensor Frontend PCB example for RFC-0005.
// Demonstrates:
// - part declarations with implements and mpn
// - interface metric contracts (declaration-only)
// - metric providers from benches and parts
// - alias-only metric forwarding in wrappers
// - bench/spec constraint block taxonomy
// - hierarchical constraint verification
// - env propagation from downstream metric values

include lib.pcb

// ============================================================================
// Bus Bundles (normally sourced from lib.std.bus)
// ============================================================================

bundle I2C {
  SDA : digital
  SCL : clock
}

bundle UART {
  TX : digital
  RX : digital
}

bundle SWD {
  SWDIO : digital
  SWCLK : clock
}

// ============================================================================
// Parts (normally sourced from lib.parts.* namespaces)
// ============================================================================

part OPA2376 implements DualOpAmp {
  mpn "OPA2376AIDDBVR"
  package "VSSOP-8"
  spice "OPA2376"

  pricing {
    option { provider = "DigiKey" sku = "296-28003-1-ND" priority = 10 }
    option { provider = "Mouser" sku = "595-OPA2376AIDDBVR" priority = 20 }
  }

  input A_INP : analog
  input A_INN : analog
  output A_OUT : analog
  input B_INP : analog
  input B_INN : analog
  output B_OUT : analog
  supply VDD
  ground GND

  metrics {
    GBW = 5.5MHz
    InputOffsetVoltage = 25uV
    CMRR = 90dB
    InputBiasCurrent = 10pA
    SlewRate = 2V/us
    SupplyVoltageMin = 2.2V
    SupplyVoltageMax = 5.5V
    SupplyCurrentMax = 950uA
    RecommendedLoadCapacitance = 100pF
  }
}

part ADS1115 implements ADCSubsystem {
  mpn "ADS1115IDGSR"
  package "MSOP-10"

  pricing {
    option { provider = "DigiKey" sku = "296-38714-1-ND" priority = 10 }
    option { provider = "Mouser" sku = "595-ADS1115IDGSR" priority = 20 }
  }

  input AIN0 : analog
  input AIN1 : analog
  input AIN2 : analog
  input AIN3 : analog
  input ADDR : digital
  io SDA : digital
  io SCL : clock
  output ALERT : digital
  supply VDD
  ground GND

  metrics {
    Resolution = 16 bits
    MaxSampleRate = 860 SPS
    INL = 0.5 LSB
    FullScaleRange = 6.144V
    SupplyVoltageMin = 2.0V
    SupplyVoltageMax = 5.5V
    SupplyCurrentMax = 200uA
    InputLeakageCurrent = 10nA
    InputCapacitance = 14pF
  }
}

part STM32G031K8 implements ControllerSubsystem {
  mpn "STM32G031K8T6"
  package "LQFP-32"

  pricing {
    option { provider = "DigiKey" sku = "497-19521-ND" priority = 10 }
    option { provider = "Mouser" sku = "511-STM32G031K8T6" priority = 20 }
  }

  io PA[0:15] : digital
  io PB[0:9] : digital
  supply VDD
  supply VDDA
  ground VSS
  input NRST : digital
  input BOOT0 : digital

  metrics {
    CoreClock = 64MHz
    FlashSize = 64kB
    RAMSize = 8kB
    SupplyVoltageMin = 1.7V
    SupplyVoltageMax = 3.6V
    SupplyCurrentMax = 10mA
  }
}

part RC0402FR(real R) implements Resistor {
  mpn "RC0402FR-07"
  package "0402"

  pricing {
    option { provider = "DigiKey" sku = "311-{R}LRCT-ND" priority = 10 }
    option { provider = "Mouser" sku = "603-RC0402FR-07{R}L" priority = 20 }
  }

  io P : analog
  io N : analog

  params { R = R }

  metrics {
    Tolerance = 1pct
    PowerRating = 63mW
    VoltageRating = 50V
  }
}

part CL05B(real C) implements Capacitor {
  mpn "CL05B"
  package "0402"

  pricing {
    option { provider = "DigiKey" sku = "1276-{C}-ND" priority = 10 }
    option { provider = "Mouser" sku = "187-CL05B{C}KO5NNNC" priority = 20 }
  }

  io P : analog
  io N : analog

  params { C = C }

  metrics {
    Tolerance = 10pct
    VoltageRating = 16V
  }
}

// ============================================================================
// Interface Contracts (metrics declaration only)
// ============================================================================

interface SensorConditioner {
  supply VDD
  ground GND
  input SENSOR_IN : Diff
  output SIGNAL_OUT : analog

  metrics {
    PassbandGain : dB
    LowpassBandwidth : Hz
    IntegratedInputNoise : Vrms
  }

  benches {
    bind DiffToSETransfer as transfer_bench {
      bench.IN--dut.SENSOR_IN
      bench.OUT--dut.SIGNAL_OUT

      metrics {
        PassbandGain = transfer_bench::PassbandGain
        LowpassBandwidth = transfer_bench::LowpassBandwidth
      }
    }

    bind DiffToSENoise as noise_bench {
      bench.IN--dut.SENSOR_IN
      bench.OUT--dut.SIGNAL_OUT

      metrics {
        IntegratedInputNoise = noise_bench::IntegratedInputNoise(from=1Hz, to=10kHz)
      }
    }
  }
}

interface ADCSubsystem {
  supply VDD
  ground GND
  input AIN : analog
  io BUS : I2C
  output DRDY : digital

  metrics {
    Resolution : bits
    MaxSampleRate : SPS
    InputCapacitance : F
  }
}

interface ControllerSubsystem {
  supply VDD
  ground GND
  io PERIPH : I2C
  input IRQ : digital
  output DEBUG : UART
  io PROG : SWD

  metrics {
    FlashSize : B
    CoreClock : Hz
  }
}

// ============================================================================
// HL Composition
// ============================================================================

circuit SensorFrontendPCB {
  level HL
  supply VDD_3V3
  ground GND
  input SENSOR : Diff
  output DEBUG : UART
  io PROG : SWD

  slot {
    net conditioned : analog
    net i2c_bus : I2C
    net drdy : digital

    // Resolve the ADC first so its metrics can drive analog bench environment.
    ADCSubsystem adc = new ADCStage() {
      .VDD--VDD_3V3
      .GND--GND
      .AIN--conditioned
      .BUS--i2c_bus
      .DRDY--drdy
    }

    SensorConditioner frontend = new WheatstoneAmplifier(load_cap=adc.InputCapacitance) {
      .VDD--VDD_3V3
      .GND--GND
      .SENSOR_IN--SENSOR
      .SIGNAL_OUT--conditioned
    }

    ControllerSubsystem mcu = new Controller() {
      .VDD--VDD_3V3
      .GND--GND
      .PERIPH--i2c_bus
      .IRQ--drdy
      .DEBUG--DEBUG
      .PROG--PROG
    }
  }

  constraints {
    bench {
      c_bw = frontend.LowpassBandwidth >= 10kHz
      c_gain = frontend.PassbandGain >= 40dB
      c_noise = frontend.IntegratedInputNoise <= 1uVrms
    }
    spec {
      c_adc_res = adc.Resolution >= 16 bits
      c_adc_rate = adc.MaxSampleRate >= 128 SPS
      c_mcu_flash = mcu.FlashSize >= 64kB
      c_mcu_clock = mcu.CoreClock >= 48MHz
    }
  }

  harness {
    supply VDD_3V3 = 3.3V
    ground GND = 0V
  }
}

// ============================================================================
// EL Implementation: Analog Frontend
// ============================================================================

circuit WheatstoneAmplifier(real load_cap=10pF) implements SensorConditioner {
  level EL
  supply VDD
  ground GND
  input SENSOR_IN : Diff
  output SIGNAL_OUT : analog

  // load_cap is expected to come from downstream ADC input capacitance.
  // If metric resolution fails at composition time, validation must fail hard.
  env {
    InputCommonModeRange = 1.65V
    SourceImpedance = 1kOhm
    LoadImpedance = (10GOhm || load_cap)
  }

  fill {
    net stage1_out : analog
    net vref : analog
    net fb_a : analog

    Resistor rDiv1 = new RC0402FR(R=100k) {
      .P--VDD
      .N--vref
    }
    Resistor rDiv2 = new RC0402FR(R=100k) {
      .P--vref
      .N--GND
    }
    Capacitor cRef = new CL05B(C=100n) {
      .P--vref
      .N--GND
    }

    DualOpAmp u1 = new OPA2376() {
      .A_INP--SENSOR_IN.P
      .A_INN--fb_a
      .A_OUT--stage1_out

      .B_INP--vref
      .B_INN--u1.B_OUT
      .B_OUT--vref

      .VDD--VDD
      .GND--GND
    }

    Resistor rG = new RC0402FR(R=1k) {
      .P--SENSOR_IN.N
      .N--fb_a
    }
    Resistor rF = new RC0402FR(R=100k) {
      .P--stage1_out
      .N--fb_a
    }

    Resistor rAa = new RC0402FR(R=1k) {
      .P--stage1_out
      .N--SIGNAL_OUT
    }
    Capacitor cAa = new CL05B(C=15n) {
      .P--SIGNAL_OUT
      .N--GND
    }

    Capacitor cByp = new CL05B(C=100n) {
      .P--VDD
      .N--GND
    }
  }

  benches {
    // Additional local bench-derived metric beyond the interface minimum.
    bind DiffToSECMRejection as cmrr_bench {
      bench.CM--dut.SENSOR_IN.P
      bench.CM--dut.SENSOR_IN.N
      bench.OUT--dut.SIGNAL_OUT

      metrics {
        CMRR = cmrr_bench::CMRR(dmGain=transfer_bench::PassbandGain)
      }
    }
  }

  metrics {
    PassbandGain = transfer_bench::PassbandGain
    LowpassBandwidth = transfer_bench::LowpassBandwidth
    IntegratedInputNoise = noise_bench::IntegratedInputNoise(from=1Hz, to=10kHz)

    // Extra implementation metric not required by SensorConditioner.
    CMRR = cmrr_bench::CMRR(dmGain=transfer_bench::PassbandGain)
  }

  constraints {
    bench {
      c_bw = LowpassBandwidth >= 10kHz
      c_gain = PassbandGain >= 38dB
      c_noise = IntegratedInputNoise <= 1uVrms
      c_cmrr = CMRR >= 20dB
    }
  }

  harness {
    supply VDD = 3.3V
    ground GND = 0V
  }
}

// ============================================================================
// EL Implementation: ADC Wrapper (alias-only metric forwarding)
// ============================================================================

circuit ADCStage implements ADCSubsystem {
  level EL
  supply VDD
  ground GND
  input AIN : analog
  io BUS : I2C
  output DRDY : digital

  fill {
    ADCSubsystem uAdc = new ADS1115() {
      .AIN0--AIN
      .AIN1--GND
      .AIN2--GND
      .AIN3--GND
      .ADDR--GND
      .SDA--BUS.SDA
      .SCL--BUS.SCL
      .ALERT--DRDY
      .VDD--VDD
      .GND--GND
    }

    Resistor rSda = new RC0402FR(R=4.7k) {
      .P--VDD
      .N--BUS.SDA
    }
    Resistor rScl = new RC0402FR(R=4.7k) {
      .P--VDD
      .N--BUS.SCL
    }

    Capacitor cVdd = new CL05B(C=100n) {
      .P--VDD
      .N--GND
    }
    Capacitor cBulk = new CL05B(C=10u) {
      .P--VDD
      .N--GND
    }
  }

  metrics {
    Resolution = uAdc.Resolution
    MaxSampleRate = uAdc.MaxSampleRate
    InputCapacitance = uAdc.InputCapacitance
  }

  harness {
    supply VDD = 3.3V
    ground GND = 0V
  }
}

// ============================================================================
// EL Implementation: MCU Wrapper (alias-only metric forwarding)
// ============================================================================

circuit Controller implements ControllerSubsystem {
  level EL
  supply VDD
  ground GND
  io PERIPH : I2C
  input IRQ : digital
  output DEBUG : UART
  io PROG : SWD

  fill {
    net nrst : digital

    ControllerSubsystem uMcu = new STM32G031K8() {
      .PA[0]--IRQ
      .PA[2]--DEBUG.TX
      .PA[3]--DEBUG.RX
      .PA[9]--PERIPH.SDA
      .PA[10]--PERIPH.SCL
      .PA[13]--PROG.SWDIO
      .PA[14]--PROG.SWCLK
      .VDD--VDD
      .VDDA--VDD
      .VSS--GND
      .NRST--nrst
      .BOOT0--GND
    }

    Resistor rRst = new RC0402FR(R=10k) {
      .P--VDD
      .N--nrst
    }
    Capacitor cRst = new CL05B(C=100n) {
      .P--nrst
      .N--GND
    }

    Capacitor cVdd = new CL05B(C=100n) {
      .P--VDD
      .N--GND
    }
    Capacitor cVdda = new CL05B(C=1u) {
      .P--VDD
      .N--GND
    }
  }

  metrics {
    FlashSize = uMcu.FlashSize
    CoreClock = uMcu.CoreClock

    // Allowed extension beyond interface minimum.
    RAMSize = uMcu.RAMSize
  }

  harness {
    supply VDD = 3.3V
    ground GND = 0V
  }
}
