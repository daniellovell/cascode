VERSION 3.1

// Sensor Frontend PCB example for RFC-0005.
// Demonstrates:
// - part declarations with catalog (explicit entries and variant-generated entries) and implements
// - part inheritance with abstract base and extends
// - selection-aware instantiation with bracket syntax ([Entry] or [axis=option])
// - MPN template strings with {axis}, {axis.field}, and {param} references
// - concrete part pin mapping via pins { ... }
// - multi-unit package grouping via units { ... }
// - interface metric contracts (declaration-only)
// - metric providers from benches and parts
// - alias-only metric forwarding in wrappers
// - bench/spec constraint block taxonomy
// - hierarchical constraint verification
// - env propagation from downstream metric values
// - corner-scoped metrics aligned with harness PVT (north star)
// - harness omitted on spec-only EL wrappers (north star)

include lib.pcb

// ============================================================================
// Bus Bundles (normally sourced from lib.std.bus)
// ============================================================================

bundle I2C {
  SDA : digital
  SCL : clock
}

bundle UART {
  TX : digital
  RX : digital
}

bundle SWD {
  SWDIO : digital
  SWCLK : clock
}

// ============================================================================
// Parts (normally sourced from lib.parts.* namespaces)
// ============================================================================

// Two entries: one IC in two packages.
part OPA2376 implements DualOpAmp {
  input A_INP : analog
  input A_INN : analog
  output A_OUT : analog
  input B_INP : analog
  input B_INN : analog
  output B_OUT : analog
  supply VDD
  ground GND

  corners {
    Room_3V3_25C { TemperatureC = 25  Supply = 3.3V }
  }

  catalog {
    defaults {
      spice = "OPA2376"

      // Pin numbering is illustrative. Production libraries should verify against the datasheet.
      pins {
        A_OUT = P1
        A_INN = P2
        A_INP = P3
        GND = P4
        B_INP = P5
        B_INN = P6
        B_OUT = P7
        VDD = P8
      }

      units {
        A { pads = (P1, P2, P3) terminals = (A_OUT, A_INN, A_INP) }
        B { pads = (P5, P6, P7) terminals = (B_INP, B_INN, B_OUT) }
        Rails { pads = (P4, P8) terminals = (GND, VDD) }
      }

      metrics {
        SupplyVoltage min = 2.2V
        SupplyVoltage max = 5.5V
        RecommendedLoadCapacitance = 100pF

        at Room_3V3_25C {
          GBW min = 5.5MHz
          GBW = 7MHz
          InputOffsetVoltage max = 25uV
          CMRR min = 90dB
          InputBiasCurrent max = 10pA
          SlewRate min = 2V/us
          SupplyCurrent max = 950uA
        }
      }
    }

    entry VSSOP8 {
      mpn = "OPA2376AIDDBVR"
      footprint = "VSSOP-8"
      option { provider = "DigiKey" sku = "296-28003-1-ND" priority = 10 }
      option { provider = "Mouser" sku = "595-OPA2376AIDDBVR" priority = 20 }
    }

    entry SOIC8 {
      mpn = "OPA2376AIDGKR"
      footprint = "SOIC-8"
      option { provider = "DigiKey" sku = "296-28004-1-ND" priority = 10 }
      option { provider = "Mouser" sku = "595-OPA2376AIDGKR" priority = 20 }
    }
  }
}

// Single-entry part: ADC with no package alternatives modeled.
part ADS1115 implements ADCSubsystem {
  input AIN0 : analog
  input AIN1 : analog
  input AIN2 : analog
  input AIN3 : analog
  input ADDR : digital
  io SDA : digital
  io SCL : clock
  output ALERT : digital
  supply VDD
  ground GND

  catalog {
    entry MSOP10 {
      mpn = "ADS1115IDGSR"
      footprint = "MSOP-10"
      option { provider = "DigiKey" sku = "296-38714-1-ND" priority = 10 }
      option { provider = "Mouser" sku = "595-ADS1115IDGSR" priority = 20 }

      // Pin numbering is illustrative. Production libraries should verify against the datasheet.
      pins {
        AIN0 = P1
        AIN1 = P2
        AIN2 = P3
        AIN3 = P4
        ADDR = P5
        SDA = P6
        SCL = P7
        ALERT = P8
        VDD = P9
        GND = P10
      }

      metrics {
        Resolution = 16bit
        MaxSampleRate = 860SPS
        INL = 0.5LSB
        FullScaleRange = 6.144V
        SupplyVoltage min = 2.0V
        SupplyVoltage max = 5.5V
        SupplyCurrent max = 200uA
        InputLeakageCurrent max = 10nA
        InputCapacitance = 14pF
      }
    }
  }
}

// Part inheritance: abstract base for STM32G0 family.
abstract part STM32G0 implements IMicrocontroller {
  supply VDD
  supply VDDA
  ground VSS
  input NRST : digital
  input BOOT0 : digital

  catalog {
    defaults {
      metrics {
        SupplyVoltage min = 1.7V
        SupplyVoltage max = 3.6V
      }
    }
  }
}

// Concrete sub-part: inherits ports and metrics from STM32G0, adds flash/package
// variant axes and device-specific ports and metrics.
part STM32G031K extends STM32G0 {
  io PA[0:15] : digital
  io PB[0:9] : digital

  catalog {
    defaults {
      mpn = "STM32G031K{flash.code}{pkg.suffix}"
      option { provider = "DigiKey" sku = "497-STM32G031K{flash.code}{pkg.suffix}-ND" priority = 10 }
      option { provider = "Mouser" sku = "511-STM32G031K{flash.code}{pkg.suffix}" priority = 20 }

      // Pin numbering is illustrative. Production libraries should verify against the datasheet.
      pins {
        VDD = P1
        VDDA = P2
        VSS = P3
        NRST = P4
        BOOT0 = P5

        PA[0:15] = P6..P21
        PB[0:9]  = P22..P31
      }

      metrics {
        CoreClock = 64MHz
        SupplyCurrent max = 10mA
      }
    }

    variant flash {
      _8 { code = "8"  metrics { FlashSize = 64kB  RAMSize = 8kB } }
      B  { code = "B"  metrics { FlashSize = 128kB  RAMSize = 16kB } }
    }

    variant pkg {
      LQFP32   { footprint = "LQFP-32"  suffix = "T6" }
      UFQFPN32 { footprint = "UFQFPN-32"  suffix = "U6" }
    }
  }
}

// Multi-axis passive family: body size and tolerance grade as independent variant
// axes. MPN is a template resolved from axis fields and constructor parameters.
part YageoRC(e96 R) implements Resistor {
  io P : analog
  io N : analog

  params { R = R }

  catalog {
    defaults {
      mpn = "RC{body.footprint}{grade.code}{R}L"

      pins {
        P = P1
        N = P2
      }
    }

    variant body {
      _0402 {
        footprint = "0402"
        metrics { PowerRating min = 63mW  VoltageRating min = 50V }
        option { provider = "DigiKey" sku = "311-{R}LRCT-ND" priority = 10 }
      }
      _0603 {
        footprint = "0603"
        metrics { PowerRating min = 100mW  VoltageRating min = 75V }
        option { provider = "DigiKey" sku = "311-{R}HRCT-ND" priority = 10 }
      }
      _0805 {
        footprint = "0805"
        metrics { PowerRating min = 125mW  VoltageRating min = 150V }
        option { provider = "DigiKey" sku = "311-{R}GRCT-ND" priority = 10 }
      }
    }

    variant grade {
      F { code = "FR-07"  metrics { Tolerance max = 1pct } }
      J { code = "JR-05"  metrics { Tolerance max = 5pct } }
    }
  }
}

part CL05B(e12 C) implements Capacitor {
  io P : analog
  io N : analog

  params { C = C }

  catalog {
    entry _0402 {
      mpn = "CL05B"
      footprint = "0402"
      option { provider = "DigiKey" sku = "1276-{C}-ND" priority = 10 }
      option { provider = "Mouser" sku = "187-CL05B{C}KO5NNNC" priority = 20 }

      pins {
        P = P1
        N = P2
      }

      metrics {
        Tolerance max = 10pct
        VoltageRating min = 16V
      }
    }
  }
}

// ============================================================================
// Interface Contracts (metrics declaration only)
// ============================================================================

interface SensorConditioner {
  supply VDD
  ground GND
  input SENSOR_IN : Diff
  output SIGNAL_OUT : analog

  metrics {
    PassbandGain : dB
    LowpassBandwidth : Hz
    IntegratedInputNoise : Vrms
  }

  benches {
    bind DiffToSETransfer as transfer_bench {
      bench.IN--dut.SENSOR_IN
      bench.OUT--dut.SIGNAL_OUT

      metrics {
        PassbandGain = transfer_bench::PassbandGain
        LowpassBandwidth = transfer_bench::LowpassBandwidth
      }
    }

    bind DiffToSENoise as noise_bench {
      bench.IN--dut.SENSOR_IN
      bench.OUT--dut.SIGNAL_OUT

      metrics {
        IntegratedInputNoise = noise_bench::IntegratedInputNoise(from=1Hz, to=10kHz)
      }
    }
  }
}

interface ADCSubsystem {
  supply VDD
  ground GND
  input AIN : analog
  io BUS : I2C
  output DRDY : digital

  metrics {
    Resolution : bit
    MaxSampleRate : SPS
    InputCapacitance : F
    SupplyVoltage : V { min, max }
    SupplyCurrent : A { max }
  }
}

interface IMicrocontroller {
  supply VDD
  ground GND
  io PERIPH : I2C
  input IRQ : digital
  output DEBUG : UART
  io PROG : SWD

  metrics {
    FlashSize : B
    CoreClock : Hz
    SupplyVoltage : V { min, max }
    SupplyCurrent : A { max }
  }
}

// ============================================================================
// HL Composition
// ============================================================================

circuit SensorFrontendPCB {
  level HL
  supply VDD_3V3
  ground GND
  input SENSOR : Diff
  output DEBUG : UART
  io PROG : SWD

  slot {
    net conditioned : analog
    net i2c_bus : I2C
    net drdy : digital

    // Resolve the ADC first so its metrics can drive analog bench environment.
    ADCSubsystem adc = new ADCStage() {
      .VDD--VDD_3V3
      .GND--GND
      .AIN--conditioned
      .BUS--i2c_bus
      .DRDY--drdy
    }

    SensorConditioner frontend = new WheatstoneAmplifier(load_cap=adc.InputCapacitance) {
      .VDD--VDD_3V3
      .GND--GND
      .SENSOR_IN--SENSOR
      .SIGNAL_OUT--conditioned
    }

    IMicrocontroller mcu = new Controller() {
      .VDD--VDD_3V3
      .GND--GND
      .PERIPH--i2c_bus
      .IRQ--drdy
      .DEBUG--DEBUG
      .PROG--PROG
    }
  }

  constraints {
    bench {
      c_bw = frontend.LowpassBandwidth >= 10kHz
      c_gain = frontend.PassbandGain >= 40dB
      c_noise = frontend.IntegratedInputNoise <= 1uVrms
    }
    spec {
      c_adc_res = adc.Resolution >= 16bit
      c_adc_rate = adc.MaxSampleRate >= 128SPS
      c_mcu_flash = mcu.FlashSize >= 64kB
      c_mcu_clock = mcu.CoreClock >= 48MHz
    }
  }

  harness {
    supply VDD_3V3 = 3.3V
    ground GND = 0V
  }
}

// ============================================================================
// EL Implementation: Analog Frontend
// ============================================================================

circuit WheatstoneAmplifier(real load_cap=10pF) implements SensorConditioner {
  level EL
  supply VDD
  ground GND
  input SENSOR_IN : Diff
  output SIGNAL_OUT : analog

  // load_cap is expected to come from downstream ADC input capacitance.
  // If metric resolution fails at composition time, validation must fail hard.
  env {
    InputCommonModeRange = 1.65V
    SourceImpedance = 1kOhm
    LoadImpedance = (10GOhm || load_cap)
  }

  fill {
    net stage1_out : analog
    net vref : analog
    net fb_a : analog

    // Multi-axis variant: named selection required in fill blocks.
    Resistor rDiv1 = new YageoRC[body=_0402, grade=F](R=100k) {
      .P--VDD
      .N--vref
    }
    Resistor rDiv2 = new YageoRC[body=_0402, grade=F](R=100k) {
      .P--vref
      .N--GND
    }
    Capacitor cRef = new CL05B(C=100n) {
      .P--vref
      .N--GND
    }

    // Explicit entry: positional selection by entry name.
    DualOpAmp u1 = new OPA2376[VSSOP8]() {
      .A_INP--SENSOR_IN.P
      .A_INN--fb_a
      .A_OUT--stage1_out

      .B_INP--vref
      .B_INN--u1.B_OUT
      .B_OUT--vref

      .VDD--VDD
      .GND--GND
    }

    Resistor rG = new YageoRC[body=_0402, grade=F](R=1k) {
      .P--SENSOR_IN.N
      .N--fb_a
    }
    Resistor rF = new YageoRC[body=_0402, grade=F](R=100k) {
      .P--stage1_out
      .N--fb_a
    }

    Resistor rAa = new YageoRC[body=_0402, grade=F](R=1k) {
      .P--stage1_out
      .N--SIGNAL_OUT
    }
    Capacitor cAa = new CL05B(C=15n) {
      .P--SIGNAL_OUT
      .N--GND
    }

    Capacitor cByp = new CL05B(C=100n) {
      .P--VDD
      .N--GND
    }
  }

  benches {
    // Additional local bench-derived metric beyond the interface minimum.
    bind DiffToSECMRejection as cmrr_bench {
      bench.CM--dut.SENSOR_IN.P
      bench.CM--dut.SENSOR_IN.N
      bench.OUT--dut.SIGNAL_OUT

      metrics {
        CMRR = cmrr_bench::CMRR(dmGain=transfer_bench::PassbandGain)
      }
    }
  }

  metrics {
    PassbandGain = transfer_bench::PassbandGain
    LowpassBandwidth = transfer_bench::LowpassBandwidth
    IntegratedInputNoise = noise_bench::IntegratedInputNoise(from=1Hz, to=10kHz)

    // Extra implementation metric not required by SensorConditioner.
    CMRR = cmrr_bench::CMRR(dmGain=transfer_bench::PassbandGain)
  }

  constraints {
    bench {
      c_bw = LowpassBandwidth >= 10kHz
      c_gain = PassbandGain >= 38dB
      c_noise = IntegratedInputNoise <= 1uVrms
      c_cmrr = CMRR >= 20dB
    }
  }

  harness {
    supply VDD = 3.3V
    ground GND = 0V
  }
}

// ============================================================================
// EL Implementation: ADC Wrapper (alias-only metric forwarding)
// ============================================================================

circuit ADCStage implements ADCSubsystem {
  level EL
  supply VDD
  ground GND
  input AIN : analog
  io BUS : I2C
  output DRDY : digital

  fill {
    // No-variant part: brackets omitted.
    ADCSubsystem uAdc = new ADS1115() {
      .AIN0--AIN
      .AIN1--GND
      .AIN2--GND
      .AIN3--GND
      .ADDR--GND
      .SDA--BUS.SDA
      .SCL--BUS.SCL
      .ALERT--DRDY
      .VDD--VDD
      .GND--GND
    }

    Resistor rSda = new YageoRC[body=_0402, grade=F](R=4.7k) {
      .P--VDD
      .N--BUS.SDA
    }
    Resistor rScl = new YageoRC[body=_0402, grade=F](R=4.7k) {
      .P--VDD
      .N--BUS.SCL
    }

    Capacitor cVdd = new CL05B(C=100n) {
      .P--VDD
      .N--GND
    }
    Capacitor cBulk = new CL05B(C=10u) {
      .P--VDD
      .N--GND
    }
  }

  metrics {
    Resolution = uAdc.Resolution
    MaxSampleRate = uAdc.MaxSampleRate
    InputCapacitance = uAdc.InputCapacitance
  }

  // Spec-only wrapper: harness omitted under the bench-executability rule.
}

// ============================================================================
// EL Implementation: MCU Wrapper (alias-only metric forwarding)
// ============================================================================

circuit Controller implements IMicrocontroller {
  level EL
  supply VDD
  ground GND
  io PERIPH : I2C
  input IRQ : digital
  output DEBUG : UART
  io PROG : SWD

  fill {
    net nrst : digital

    // Inheritance + multi-axis variant: all axes selected in fill block.
    IMicrocontroller uMcu = new STM32G031K[flash=_8, pkg=LQFP32]() {
      .PA[0]--IRQ
      .PA[2]--DEBUG.TX
      .PA[3]--DEBUG.RX
      .PA[9]--PERIPH.SDA
      .PA[10]--PERIPH.SCL
      .PA[13]--PROG.SWDIO
      .PA[14]--PROG.SWCLK
      .VDD--VDD
      .VDDA--VDD
      .VSS--GND
      .NRST--nrst
      .BOOT0--GND
    }

    Resistor rRst = new YageoRC[body=_0402, grade=F](R=10k) {
      .P--VDD
      .N--nrst
    }
    Capacitor cRst = new CL05B(C=100n) {
      .P--nrst
      .N--GND
    }

    Capacitor cVdd = new CL05B(C=100n) {
      .P--VDD
      .N--GND
    }
    Capacitor cVdda = new CL05B(C=1u) {
      .P--VDD
      .N--GND
    }
  }

  metrics {
    FlashSize = uMcu.FlashSize
    CoreClock = uMcu.CoreClock

    // Allowed extension beyond interface minimum.
    RAMSize = uMcu.RAMSize
  }

  // Spec-only wrapper: harness omitted under the bench-executability rule.
}
