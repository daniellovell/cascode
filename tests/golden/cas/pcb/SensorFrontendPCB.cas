VERSION 3.0

// Sensor Frontend PCB example for RFC-0005.
// Demonstrates:
// - part declarations with implements and mpn
// - interface metric contracts (declaration-only)
// - channel sub-interfaces (SingleEndedOpAmp channels on DualOpAmp)
// - metric providers from benches and parts
// - alias-only metric forwarding in wrappers
// - unified metric-based constraints
// - env propagation from downstream metric values

include lib.pcb

// ============================================================================
// Bus Bundles (normally sourced from lib.pcb)
// ============================================================================

bundle I2C {
  SDA : digital
  SCL : clock
}

bundle UART {
  TX : digital
  RX : digital
}

bundle SWD {
  SWDIO : digital
  SWCLK : clock
}

// ============================================================================
// Channel Interfaces (normally sourced from lib.pcb)
// ============================================================================

interface SingleEndedOpAmp {
  input INP : analog
  input INN : analog
  output OUT : analog
}

// ============================================================================
// Parts (normally sourced from lib.pcb.parts.* namespaces)
// ============================================================================

part OPA2376 implements DualOpAmp {
  mpn "OPA2376AIDDBVR"
  package "VSSOP-8"
  spice "OPA2376"

  pricing {
    option { provider = "DigiKey" sku = "296-28003-1-ND" priority = 10 }
    option { provider = "Mouser" sku = "595-OPA2376AIDDBVR" priority = 20 }
  }

  channel A : SingleEndedOpAmp
  channel B : SingleEndedOpAmp
  supply VDD
  ground GND

  metrics {
    GBW = 5.5MHz
    InputOffsetVoltage = 25uV
    CMRR = 114dB
    InputBiasCurrent = 0.2pA
    SlewRate = 2V/us
    SupplyVoltageMin = 2.2V
    SupplyVoltageMax = 5.5V
    SupplyCurrentMax = 285uA
    RecommendedLoadCapacitance = 100pF
  }
}

part ADS1115 implements ADCSubsystem {
  mpn "ADS1115IDGSR"
  package "MSOP-10"

  pricing {
    option { provider = "DigiKey" sku = "296-38714-1-ND" priority = 10 }
    option { provider = "Mouser" sku = "595-ADS1115IDGSR" priority = 20 }
  }

  input AIN0 : analog
  input AIN1 : analog
  input AIN2 : analog
  input AIN3 : analog
  input ADDR : digital
  io SDA : digital
  io SCL : clock
  output ALERT : digital
  supply VDD
  ground GND

  metrics {
    Resolution = 16 bits
    MaxSampleRate = 860 SPS
    INL = 0.5 LSB
    FullScaleRange = 6.144V
    SupplyVoltageMin = 2.0V
    SupplyVoltageMax = 5.5V
    SupplyCurrentMax = 200uA
    InputLeakageCurrent = 10nA
    InputCapacitance = 14pF
  }
}

part STM32G031K8 implements ControllerSubsystem {
  mpn "STM32G031K8T6"
  package "LQFP-32"

  pricing {
    option { provider = "DigiKey" sku = "497-19521-ND" priority = 10 }
    option { provider = "Mouser" sku = "511-STM32G031K8T6" priority = 20 }
  }

  io PA[0:15] : digital
  io PB[0:9] : digital
  supply VDD
  supply VDDA
  ground VSS
  input NRST : digital
  input BOOT0 : digital

  metrics {
    CoreClock = 64MHz
    FlashSize = 64kB
    RAMSize = 8kB
    SupplyVoltageMin = 2.0V
    SupplyVoltageMax = 3.6V
    SupplyCurrentMax = 10mA
  }
}

part R_0402(real R) implements Resistor {
  mpn "RES-0402-1PCT"
  package "0402"

  pricing {
    option { provider = "DigiKey" sku = "RES-0402-1PCT" priority = 10 }
    option { provider = "Mouser" sku = "RES-0402-1PCT" priority = 20 }
  }

  io P : analog
  io N : analog

  params { R = R }

  metrics {
    Tolerance = 1pct
    PowerRating = 63mW
    VoltageRating = 50V
  }
}

part C_0402(real C) implements Capacitor {
  mpn "CAP-0402-X7R"
  package "0402"

  pricing {
    option { provider = "DigiKey" sku = "CAP-0402-X7R" priority = 10 }
    option { provider = "Mouser" sku = "CAP-0402-X7R" priority = 20 }
  }

  io P : analog
  io N : analog

  params { C = C }

  metrics {
    Tolerance = 10pct
    VoltageRating = 16V
  }
}

// ============================================================================
// Interface Contracts (metrics declaration only)
// ============================================================================

interface SensorConditioner {
  supply VDD
  ground GND
  input SENSOR_IN : Diff
  output SIGNAL_OUT : analog

  metrics {
    PassbandGain : dB
    LowpassBandwidth : Hz
    IntegratedInputNoise : Vrms
  }

  benches {
    bind DiffToSETransfer as transfer_bench {
      bench.IN--dut.SENSOR_IN
      bench.OUT--dut.SIGNAL_OUT

      metrics {
        PassbandGain = transfer_bench::PassbandGain
        LowpassBandwidth = transfer_bench::LowpassBandwidth
      }
    }

    bind DiffToSENoise as noise_bench {
      bench.IN--dut.SENSOR_IN
      bench.OUT--dut.SIGNAL_OUT

      metrics {
        IntegratedInputNoise = noise_bench::IntegratedInputNoise(from=1Hz, to=10kHz)
      }
    }
  }
}

interface ADCSubsystem {
  supply VDD
  ground GND
  input AIN : analog
  io BUS : I2C
  output DRDY : digital

  metrics {
    Resolution : bits
    MaxSampleRate : SPS
    InputCapacitance : F
  }
}

interface ControllerSubsystem {
  supply VDD
  ground GND
  io PERIPH : I2C
  input IRQ : digital
  output DEBUG : UART
  io PROG : SWD

  metrics {
    FlashSize : B
    CoreClock : Hz
  }
}

// ============================================================================
// HL Composition
// ============================================================================

circuit SensorFrontendPCB {
  level HL
  supply VDD_3V3
  ground GND
  input SENSOR : Diff
  output DEBUG : UART
  io PROG : SWD

  slot {
    net conditioned : analog
    net i2c_bus : I2C
    net drdy : digital

    // Resolve the ADC first so its metrics can drive analog bench environment.
    ADCSubsystem adc = new ADCStage() {
      .VDD--VDD_3V3
      .GND--GND
      .AIN--conditioned
      .BUS--i2c_bus
      .DRDY--drdy
    }

    SensorConditioner frontend = new WheatstoneAmplifier(load_cap=adc::InputCapacitance) {
      .VDD--VDD_3V3
      .GND--GND
      .SENSOR_IN--SENSOR
      .SIGNAL_OUT--conditioned
    }

    ControllerSubsystem mcu = new Controller() {
      .VDD--VDD_3V3
      .GND--GND
      .PERIPH--i2c_bus
      .IRQ--drdy
      .DEBUG--DEBUG
      .PROG--PROG
    }
  }

  constraints {
    numeric {
      // Simulable analog chain expressed through interface metrics.
      c_bw = frontend::LowpassBandwidth >= 10kHz
      c_gain = frontend::PassbandGain >= 40dB
      c_noise = frontend::IntegratedInputNoise <= 1uVrms

      // Datasheet-driven digital blocks through forwarded metrics.
      c_adc_res = adc::Resolution >= 16 bits
      c_adc_rate = adc::MaxSampleRate >= 128 SPS
      c_mcu_flash = mcu::FlashSize >= 64kB
      c_mcu_clock = mcu::CoreClock >= 48MHz
    }
  }

  harness {
    supply VDD_3V3 = 3.3V
    ground GND = 0V
  }
}

// ============================================================================
// EL Implementation: Analog Frontend
// ============================================================================

circuit WheatstoneAmplifier(real load_cap=10pF) implements SensorConditioner {
  level EL
  supply VDD
  ground GND
  input SENSOR_IN : Diff
  output SIGNAL_OUT : analog

  // load_cap is expected to come from downstream ADC input capacitance.
  // If metric resolution fails at composition time, validation must fail hard.
  env {
    InputCommonModeRange = 1.65V
    SourceImpedance = 1kOhm
    LoadImpedance = (10GOhm || load_cap)
  }

  fill {
    net stage1_out : analog
    net vref : analog
    net fb_a : analog

    Resistor R_DIV1 = new R_0402(R=100k) {
      .P--VDD
      .N--vref
    }
    Resistor R_DIV2 = new R_0402(R=100k) {
      .P--vref
      .N--GND
    }
    Capacitor C_REF = new C_0402(C=100n) {
      .P--vref
      .N--GND
    }

    DualOpAmp U1 = new OPA2376() {
      .A.INP--SENSOR_IN.P
      .A.INN--fb_a
      .A.OUT--stage1_out

      .B.INP--vref
      .B.INN--U1.B.OUT
      .B.OUT--vref

      .VDD--VDD
      .GND--GND
    }

    Resistor R_G = new R_0402(R=1k) {
      .P--SENSOR_IN.N
      .N--fb_a
    }
    Resistor R_F = new R_0402(R=100k) {
      .P--stage1_out
      .N--fb_a
    }

    Resistor R_AA = new R_0402(R=1k) {
      .P--stage1_out
      .N--SIGNAL_OUT
    }
    Capacitor C_AA = new C_0402(C=15n) {
      .P--SIGNAL_OUT
      .N--GND
    }

    Capacitor C_BYP = new C_0402(C=100n) {
      .P--VDD
      .N--GND
    }
  }

  benches {
    // Additional local bench-derived metric beyond the interface minimum.
    bind DiffToSECMRejection as cmrr_bench {
      bench.CM--dut.SENSOR_IN.P
      bench.CM--dut.SENSOR_IN.N
      bench.OUT--dut.SIGNAL_OUT

      metrics {
        CMRR = cmrr_bench::CMRR(dmGain=transfer_bench::PassbandGain)
      }
    }
  }

  metrics {
    PassbandGain = transfer_bench::PassbandGain
    LowpassBandwidth = transfer_bench::LowpassBandwidth
    IntegratedInputNoise = noise_bench::IntegratedInputNoise(from=1Hz, to=10kHz)

    // Extra implementation metric not required by SensorConditioner.
    CMRR = cmrr_bench::CMRR(dmGain=transfer_bench::PassbandGain)
  }

  constraints {
    numeric {
      c_bw = metrics::LowpassBandwidth >= 10kHz
      c_gain = metrics::PassbandGain >= 38dB
      c_noise = metrics::IntegratedInputNoise <= 1uVrms
      c_cmrr = metrics::CMRR >= 20dB
    }
  }

  harness {
    supply VDD = 3.3V
    ground GND = 0V
  }
}

// ============================================================================
// EL Implementation: ADC Wrapper (alias-only metric forwarding)
// ============================================================================

circuit ADCStage implements ADCSubsystem {
  level EL
  supply VDD
  ground GND
  input AIN : analog
  io BUS : I2C
  output DRDY : digital

  fill {
    ADCSubsystem U_ADC = new ADS1115() {
      .AIN0--AIN
      .AIN1--GND
      .AIN2--GND
      .AIN3--GND
      .ADDR--GND
      .SDA--BUS.SDA
      .SCL--BUS.SCL
      .ALERT--DRDY
      .VDD--VDD
      .GND--GND
    }

    Resistor R_SDA = new R_0402(R=4.7k) {
      .P--VDD
      .N--BUS.SDA
    }
    Resistor R_SCL = new R_0402(R=4.7k) {
      .P--VDD
      .N--BUS.SCL
    }

    Capacitor C_VDD = new C_0402(C=100n) {
      .P--VDD
      .N--GND
    }
    Capacitor C_BULK = new C_0402(C=10u) {
      .P--VDD
      .N--GND
    }
  }

  metrics {
    Resolution = U_ADC::Resolution
    MaxSampleRate = U_ADC::MaxSampleRate
    InputCapacitance = U_ADC::InputCapacitance
  }

  harness {
    supply VDD = 3.3V
    ground GND = 0V
  }
}

// ============================================================================
// EL Implementation: MCU Wrapper (alias-only metric forwarding)
// ============================================================================

circuit Controller implements ControllerSubsystem {
  level EL
  supply VDD
  ground GND
  io PERIPH : I2C
  input IRQ : digital
  output DEBUG : UART
  io PROG : SWD

  fill {
    net nrst : digital

    ControllerSubsystem U_MCU = new STM32G031K8() {
      .PA[0]--IRQ
      .PA[2]--DEBUG.TX
      .PA[3]--DEBUG.RX
      .PA[9]--PERIPH.SDA
      .PA[10]--PERIPH.SCL
      .PA[13]--PROG.SWDIO
      .PA[14]--PROG.SWCLK
      .VDD--VDD
      .VDDA--VDD
      .VSS--GND
      .NRST--nrst
      .BOOT0--GND
    }

    Resistor R_RST = new R_0402(R=10k) {
      .P--VDD
      .N--nrst
    }
    Capacitor C_RST = new C_0402(C=100n) {
      .P--nrst
      .N--GND
    }

    Capacitor C_VDD = new C_0402(C=100n) {
      .P--VDD
      .N--GND
    }
    Capacitor C_VDDA = new C_0402(C=1u) {
      .P--VDD
      .N--GND
    }
  }

  metrics {
    FlashSize = U_MCU::FlashSize
    CoreClock = U_MCU::CoreClock

    // Allowed extension beyond interface minimum.
    RAMSize = U_MCU::RAMSize
  }

  harness {
    supply VDD = 3.3V
    ground GND = 0V
  }
}
