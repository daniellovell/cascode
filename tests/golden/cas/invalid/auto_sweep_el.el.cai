VERSION 3.2

primitive NMOS Level1_NMOS(size primSize) {
  device "level1_nmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


circuit InvalidAutoSweep implements SingleEndedAmp {
  level EL
  supply VDD
  ground GND
  input IN : analog
  output OUT : analog
  fill {
    NMOS M_in = new Level1_NMOS(size(W=10u, L=180n, M=1)) {
      .D--OUT
      .G--IN
      .S--GND
      .B--GND
    }
  }
  harness {
    supply VDD = 1.8V
    sweep InputDCBias [Auto]
    load OUT C=1pF
  }
}
