VERSION 4.0

primitive NMOS NMOS_Level1(size primSize) {
  device "nmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


// Circuit with undefined net reference - EMIT-002 violation
// Device M1 references 'nonexistent_net' which is not declared

circuit UndefinedNetExample {
  level EL

  supply VDD
  ground GND

  output OUT : analog

  fill {
    NMOS M1 = new NMOS_Level1(size(W=1u, L=180n, M=1)) {
      .G--nonexistent_net
      .D--OUT
      .S--GND
      .B--GND
    }
  }
}
