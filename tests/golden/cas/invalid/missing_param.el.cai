VERSION 3.0

primitive NMOS Level1_NMOS(size primSize) {
  device "level1_nmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


// Circuit with missing required size values - EMIT-007 violation
// Device M1 uses ?? placeholders for required W/L

circuit MissingParamExample {
  level EL

  supply VDD
  ground GND

  input IN : analog
  output OUT : analog

  fill {
    NMOS M1 = new Level1_NMOS(size(W=??, L=??, M=1)) {
      .G--IN
      .D--OUT
      .S--GND
      .B--GND
    }
  }
}
