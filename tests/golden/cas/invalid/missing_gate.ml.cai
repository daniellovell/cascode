VERSION 3.0

primitive PMOS Level1_PMOS(size primSize) {
  device "level1_pmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


// ML-level circuit with a missing gate binding - ERC-001 violation
// The M_SENSE device has no G-- binding at all

circuit MissingGateExample {
  level ML

  supply VDD
  ground GND

  output OUT : analog

  fill {
    PMOS M_SENSE = new Level1_PMOS(size(W=??, L=??, M=??)) {
      .B--VDD
      .D--OUT
      .S--VDD
    }
  }
}
