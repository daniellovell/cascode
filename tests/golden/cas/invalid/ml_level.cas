VERSION 4.0

// Circuit at ML level - EMIT-005 violation
// Cannot emit SPICE from non-EL level circuit

circuit MLLevelExample {
  level ML

  supply VDD
  ground GND

  input IN : analog
  output OUT : analog

  fill {
    net tnode : analog

    DiffPair dp = new DiffPair(p=NMOS) {
      .IN--IN
      .OUT--OUT
      .BIAS--tnode
    }
  }
}
