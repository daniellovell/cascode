VERSION 5.0

primitive ResistorIdeal(size primSize) implements Resistor {
  device "resistor"
  params {
    R = primSize.R
  }
}

primitive NMOS_Level1(size primSize) implements NMOS {
  device "nmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


// Circuit with passive device bridging supply rails - ERC-007 violation
// Resistor R_short directly connects VDD to GND

circuit PassiveShortExample {
  level EL

  supply VDD
  ground GND

  input IN : analog
  output OUT : analog

  fill {
    NMOS M_in = new NMOS_Level1(size(W=1u, L=180n, M=1)) {
      .G--IN
      .D--OUT
      .S--GND
      .B--GND
    }
    Resistor R_short = new ResistorIdeal(size(R=1k)) {
      .P--VDD
      .N--GND
    }
  }
}
