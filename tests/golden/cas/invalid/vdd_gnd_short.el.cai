VERSION 4.0

primitive NMOS NMOS_Level1(size primSize) {
  device "nmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


// Circuit with VDD-GND short - ERC-002 violation
// Device M_short has drain on VDD and source on GND

circuit VddGndShortExample {
  level EL

  supply VDD
  ground GND

  input IN : analog

  fill {
    NMOS M_short = new NMOS_Level1(size(W=1u, L=180n, M=1)) {
      .G--IN
      .D--VDD
      .S--GND
      .B--GND
    }
  }
}
