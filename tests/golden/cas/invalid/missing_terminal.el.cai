VERSION 5.0

primitive NMOS_Level1(size primSize) implements NMOS {
  device "nmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


// Circuit with missing terminal - EMIT-001 violation
// Device M1 is missing the bulk (B) terminal

circuit MissingTerminalExample {
  level EL

  supply VDD
  ground GND

  input IN : analog
  output OUT : analog

  fill {
    NMOS M1 = new NMOS_Level1(size(W=1u, L=180n, M=1)) {
      .G--IN
      .D--OUT
      .S--GND
    }
  }
}
