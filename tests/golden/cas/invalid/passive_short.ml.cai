VERSION 4.0

primitive Resistor ResistorIdeal(size primSize) {
  device "resistor"
  params {
    R = primSize.R
  }
}

primitive NMOS NMOS_Level1(size primSize) {
  device "nmos_level1"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


// ML-level circuit with passive device bridging supply rails - ERC-007 violation
// Resistor R_short directly connects VDD to GND

circuit PassiveShortExample {
  level ML

  supply VDD
  ground GND

  input IN : analog
  output OUT : analog

  fill {
    NMOS M_in = new NMOS_Level1(size(W=??, L=??, M=??)) {
      .G--IN
      .D--OUT
      .S--GND
      .B--GND
    }
    Resistor R_short = new ResistorIdeal(size(R=1k)) {
      .P--VDD
      .N--GND
    }
  }
}
