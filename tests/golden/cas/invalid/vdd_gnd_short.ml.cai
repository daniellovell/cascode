VERSION 3.2

primitive NMOS Level1_NMOS(size primSize) {
  device "level1_nmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


// ML-level circuit with VDD-GND short - ERC-002 violation
// Device M_short has drain on VDD and source on GND

circuit VddGndShortExample {
  level ML

  supply VDD
  ground GND

  input IN : analog

  fill {
    NMOS M_short = new Level1_NMOS(size(W=??, L=??, M=??)) {
      .G--IN
      .D--VDD
      .S--GND
      .B--GND
    }
  }
}
