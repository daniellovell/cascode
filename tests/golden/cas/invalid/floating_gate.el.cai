VERSION 3.2

primitive NMOS Level1_NMOS(size primSize) {
  device "level1_nmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


// Circuit with a floating gate - ERC-001 violation
// The gate of M1 connects to 'floating_net' which has no driver

circuit FloatingGateExample {
  level EL

  supply VDD
  ground GND

  output OUT : analog

  fill {
    net floating_net : analog

    NMOS M1 = new Level1_NMOS(size(W=1u, L=180n, M=1)) {
      .G--floating_net
      .D--OUT
      .S--GND
      .B--GND
    }
  }
}
