ACIR 3.0

// This file exercises all arrow (->) contexts with deliberate whitespace
// variations. The parser must accept any combination of leading/trailing
// whitespace around the arrow operator.

bundle Diff:
  P : analog
  N : analog

trait MirrorLike:
  port SENSE : analog
  port TAP : analog
  connectors:
    to LoadLike:
      SENSE->OUT.P
      // no whitespace (canonical form)
      TAP -> OUT.N
      // spaces around arrow

trait LoadLike:
  port OUT : Diff

bench ACBench for SingleEndedOpAmp
  builtin SEOpAmpACBench
  outputs:
    PassbandGain

circuit ArrowWhitespace implements SingleEndedOpAmp
  level EL
  supply VDD
  ground GND
  port IN : Diff
  port OUT : analog
  fill:
    net mid : analog
    // Device bindings: mixed whitespace styles within a single declaration
    nmos M1 (B->GND, D->mid, G -> IN.P, S  ->GND) : W=1u L=180n nmos
    // B->GND: no whitespace
    // D->mid: no whitespace
    // G -> IN.P: spaces around arrow
    // S  ->GND: leading space only
    nmos M2 (B->  GND, D->OUT, G->IN.N, S->mid) : W=1u L=180n nmos
    // B->  GND: trailing space only
    // remaining: no whitespace
    inst dp (dp.VDD->VDD, dp.GND -> GND) : DiffPairSub
      // Instance bindings: mixed whitespace
      connect dp.IN->IN
      // no whitespace
      connect dp.OUT -> mid
      // spaces around arrow
  constraints:
    numeric:
      c_gain : ACBench::PassbandGain >= 20dB
  harness:
    supply VDD = 1.8V
    load OUT C=1pF

circuit DiffPairSub implements LoadLike
  level EL
  inline
  supply VDD
  ground GND
  port IN : Diff
  port OUT : Diff
  fill:
    net tnode : analog
    nmos M_N (B->GND, D->OUT.N, G->IN.P, S->tnode) : W=2u L=180n nmos
    nmos M_P (B->GND, D  ->OUT.P, G->IN.N, S->  tnode) : W=2u L=180n nmos
    // D  ->OUT.P: leading space only
    // S->  tnode: trailing space only
    nmos M_TAIL (B -> GND, D -> tnode, G -> VDD, S -> GND) : W=4u L=180n nmos
    // all bindings with spaces around arrow
