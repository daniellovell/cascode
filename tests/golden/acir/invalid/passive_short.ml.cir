ACIR 3.0

// ML-level circuit with passive device bridging supply rails - ERC-007 violation
// Resistor R_short directly connects VDD to GND

circuit PassiveShortExample
  level ML

  supply VDD
  ground GND

  input IN : analog
  output OUT : analog

  fill:
    nmos M_in (.G--IN, .D--OUT, .S--GND, .B--GND) : nmos
      size (W=??, L=??, M=??)
    resistor R_short (.P--VDD, .N--GND) : resistor
      R = 1k
