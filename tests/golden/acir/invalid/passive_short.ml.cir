ACIR 3.0

; ML-level circuit with passive device bridging supply rails - ERC-007 violation
; Resistor R_short directly connects VDD to GND

circuit PassiveShortExample
  level ML

  supply VDD
  ground GND

  port IN : analog
  port OUT : analog

  fill:
    nmos M_in (G->IN, D->OUT, S->GND, B->GND) : size=(W=??, L=??, M=??) nmos
    resistor R_short (P->VDD, N->GND) : R=1k
