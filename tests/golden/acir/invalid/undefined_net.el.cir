ACIR 2.0

; Circuit with undefined net reference - EMIT-002 violation
; Device M1 references 'nonexistent_net' which is not declared

circuit UndefinedNetExample
  level EL

  supply VDD
  ground GND

  port OUT : analog

  fill:
    nmos M1 (G->nonexistent_net, D->OUT, S->GND, B->GND) : size=(W=1u, L=180n, M=1) nmos
