ACIR 3.0

bench DCBench for SingleEndedAmp
  builtin SEAmpDCBench
  outputs:
    OutputDCBias
    QuiescentPower

circuit InvalidAutoSweep implements SingleEndedAmp
  level EL
  supply VDD
  ground GND
  input IN : analog
  output OUT : analog
  fill:
    nmos M_in (.D--OUT, .G--IN, .S--GND, .B--GND) : nmos
      size (W=10u, L=180n, M=1)
  harness:
    supply VDD = 1.8V
    sweep InputDCBias [Auto]
    load OUT C=1pF
