ACIR 1

circuit InvalidAutoSweep : SingleEndedAmp
  level EL
  supply VDD
  ground GND
  port IN : analog
  port OUT : analog
  fill:
    nmos M_in (D->OUT, G->IN, S->GND, B->GND) : W=10u L=180n M=1 nmos
  harness:
    supply VDD = 1.8V
    sweep InputDCBias [Auto]
    load OUT C=1p F
  benches:
    SEAmpDCBench
