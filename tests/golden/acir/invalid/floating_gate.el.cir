ACIR 2.0

; Circuit with a floating gate - ERC-001 violation
; The gate of M1 connects to 'floating_net' which has no driver

circuit FloatingGateExample
  level EL

  supply VDD
  ground GND

  port OUT : analog

  fill:
    net floating_net : analog

    nmos M1 (G->floating_net, D->OUT, S->GND, B->GND) : W=1u L=180n nmos
