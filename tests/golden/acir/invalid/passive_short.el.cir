ACIR 3.0

primitive resistor Ideal_Resistor(size primSize) {
  device "resistor"
  params {
    R = primSize.R
  }
}

primitive nmos Level1_NMOS(size primSize) {
  device "level1_nmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


// Circuit with passive device bridging supply rails - ERC-007 violation
// Resistor R_short directly connects VDD to GND

circuit PassiveShortExample {
  level EL

  supply VDD
  ground GND

  input IN : analog
  output OUT : analog

  fill {
    nmos M_in = new Level1_NMOS(size(W=1u, L=180n, M=1)) {
      .G--IN
      .D--OUT
      .S--GND
      .B--GND
    }
    resistor R_short = new Ideal_Resistor(size(R=1k)) {
      .P--VDD
      .N--GND
    }
  }
}
