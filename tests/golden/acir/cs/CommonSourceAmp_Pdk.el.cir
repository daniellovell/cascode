ACIR 3.0

bench ACBench for SingleEndedAmp
  builtin SEAmpACBench
  outputs:
    GainBandwidth
    PassbandGain

circuit CommonSourceAmp_Pdk implements SingleEndedAmp
  level EL
  supply VDD
  ground GND
  input IN : analog
  output OUT : analog
  input VBIAS : bias
  fill:
    nmos M_in (.D--OUT, .G--IN, .S--GND, .B--GND) : nfet_01v8
      size (W=10u, L=180n, M=1)
    pmos load.M (.D--OUT, .G--VBIAS, .S--VDD, .B--VDD) : pfet_01v8
      size (W=20u, L=180n, M=1)
  constraints:
    numeric:
      c_gbw : ACBench::GainBandwidth at net::OUT >= 50MHz
      c_gain : ACBench::PassbandGain at net::OUT >= 30dB
  harness:
    supply VDD = 1.8V
    bias VBIAS = 0.7V
    load OUT C=1pF
