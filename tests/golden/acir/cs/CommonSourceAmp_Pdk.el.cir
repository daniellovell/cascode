ACIR 3.0

bench ACBench for SingleEndedAmp
  builtin SEAmpACBench
  outputs:
    GainBandwidth
    PassbandGain

circuit CommonSourceAmp_Pdk implements SingleEndedAmp
  level EL
  supply VDD
  ground GND
  port IN : analog
  port OUT : analog
  port VBIAS : bias
  fill:
    nmos M_in (D->OUT, G->IN, S->GND, B->GND) : size=(W=10u, L=180n, M=1) nfet_01v8
    pmos load.M (D->OUT, G->VBIAS, S->VDD, B->VDD) : size=(W=20u, L=180n, M=1) pfet_01v8
  constraints:
    numeric:
      c_gbw : ACBench::GainBandwidth at net::OUT >= 50MHz
      c_gain : ACBench::PassbandGain at net::OUT >= 30dB
  harness:
    supply VDD = 1.8V
    bias VBIAS = 0.7V
    load OUT C=1pF
