ACIR 3.0

circuit CSAmpResistive : SingleEndedAmp
  level EL
  supply VDD
  ground GND
  port IN : analog
  port OUT : analog
  fill:
    nmos M_in (D->OUT, G->IN, S->GND, B->GND) : size=(W=10u, L=180n, M=1) nmos
    resistor R_load (P->VDD, N->OUT) : R=10k
  constraints:
    numeric:
      c_gbw : GainBandwidth @ OUT >= 10MHz
      c_gain : PassbandGain @ OUT >= 20dB
    measure:
      m_gbw : SEAmpACBench GainBandwidth @ OUT
      m_gain : SEAmpACBench PassbandGain @ OUT
  harness:
    supply VDD = 1.8V
    load OUT C=1pF
  benches:
    SEAmpACBench

