ACIR 3.0

bench ACBench for SingleEndedAmp
  builtin SEAmpACBench
  outputs:
    GainBandwidth
    PassbandGain

circuit CSAmpResistive implements SingleEndedAmp
  level EL
  supply VDD
  ground GND
  input IN : analog
  output OUT : analog
  fill:
    nmos M_in (.D--OUT, .G--IN, .S--GND, .B--GND) : nmos
      size (W=10u, L=180n, M=1)
    resistor R_load (.P--VDD, .N--OUT) : resistor
      R = 10k
  constraints:
    numeric:
      c_gbw : ACBench::GainBandwidth at net::OUT >= 10MHz
      c_gain : ACBench::PassbandGain at net::OUT >= 20dB
  harness:
    supply VDD = 1.8V
    load OUT C=1pF
