ACIR 3.0

bench ACBench for SingleEndedAmp
  builtin SEAmpACBench
  outputs:
    GainBandwidth
    PassbandGain

bench DCBench for SingleEndedAmp
  builtin SEAmpDCBench
  outputs:
    OutputDCBias
    QuiescentPower

circuit CommonSourceAmp_MultiBench implements SingleEndedAmp
  level EL
  supply VDD
  ground GND
  port IN : analog
  port OUT : analog
  port VBIAS : bias
  fill:
    nmos M_in (D->OUT, G->IN, S->GND, B->GND) : size=(W=10u, L=180n, M=1) nmos
    pmos load.M (D->OUT, G->VBIAS, S->VDD, B->VDD) : size=(W=20u, L=180n, M=1) pmos
  constraints:
    numeric:
      c_gbw : ACBench::GainBandwidth at net::OUT >= 1kHz
      c_gain : ACBench::PassbandGain at net::OUT >= 0dB
      c_out_bias : DCBench::OutputDCBias at net::OUT >= 0V
      c_power : DCBench::QuiescentPower <= 1W
  harness:
    supply VDD = 1.8V
    bias VBIAS = 0.7V
    load OUT C=1pF
