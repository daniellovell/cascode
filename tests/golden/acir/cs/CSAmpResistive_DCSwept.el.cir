ACIR 3.0

bench DCBench for SingleEndedAmp
  builtin SEAmpDCBench
  outputs:
    OutputDCBias
    QuiescentPower

circuit CSAmpResistive_DCSwept implements SingleEndedAmp
  level EL
  supply VDD
  ground GND
  input IN : analog
  output OUT : analog
  fill:
    nmos M_in (.D--OUT, .G--IN, .S--GND, .B--GND) : nmos
      size (W=10u, L=180n, M=1)
    resistor R_load (.P--VDD, .N--OUT) : resistor
      R = 10k
  constraints:
    numeric:
      c_out_bias : DCBench::OutputDCBias at net::OUT >= 0.4V
      c_power : DCBench::QuiescentPower <= 500uW
  harness:
    supply VDD = 1.8V
    sweep InputDCBias [0.3V:100mV:1.5V]
    load OUT C=1pF
