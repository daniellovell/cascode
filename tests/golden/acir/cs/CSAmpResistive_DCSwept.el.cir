ACIR 1.0

circuit CSAmpResistive_DCSwept : SingleEndedAmp
  level EL
  supply VDD
  ground GND
  port IN : analog
  port OUT : analog
  fill:
    nmos M_in (D->OUT, G->IN, S->GND, B->GND) : W=10u L=180n M=1 nmos
    resistor R_load (P->VDD, N->OUT) : R=10k
  constraints:
    numeric:
      c_out_bias : OutputDCBias @ OUT >= 0.4 V
      c_power : QuiescentPower <= 500u W
    measure:
      m_out_bias : SEAmpDCBench OutputDCBias @ OUT
      m_power : SEAmpDCBench QuiescentPower
  harness:
    supply VDD = 1.8V
    sweep InputDCBias [0.3V:100mV:1.5V]
    load OUT C=1pF
  benches:
    SEAmpDCBench
