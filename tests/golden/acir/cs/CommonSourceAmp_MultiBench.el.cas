VERSION 3.0

primitive nmos Level1_NMOS(size primSize) {
  device "level1_nmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}

primitive pmos Level1_PMOS(size primSize) {
  device "level1_pmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


bench ACBench for SingleEndedAmp {
  builtin SEAmpACBench
  outputs {
    GainBandwidth
    PassbandGain

  }
}
bench DCBench for SingleEndedAmp {
  builtin SEAmpDCBench
  outputs {
    OutputDCBias
    QuiescentPower

  }
}
circuit CommonSourceAmp_MultiBench implements SingleEndedAmp {
  level EL
  supply VDD
  ground GND
  input IN : analog
  output OUT : analog
  input VBIAS : bias
  fill {
    nmos M_in = new Level1_NMOS(size(W=10u, L=180n, M=1)) {
      .D--OUT
      .G--IN
      .S--GND
      .B--GND
    }
    pmos load.M = new Level1_PMOS(size(W=20u, L=180n, M=1)) {
      .D--OUT
      .G--VBIAS
      .S--VDD
      .B--VDD
    }
  }
  constraints {
    numeric {
      c_gbw = ACBench::GainBandwidth at net::OUT >= 1kHz
      c_gain = ACBench::PassbandGain at net::OUT >= 0dB
      c_out_bias = DCBench::OutputDCBias at net::OUT >= 0V
      c_power = DCBench::QuiescentPower <= 1W
    }
  }
  harness {
    supply VDD = 1.8V
    bias VBIAS = 0.7V
    load OUT C=1pF
  }
}
