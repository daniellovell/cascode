      "name": "IN_P",
      "direction": "input",
      "kind": "analog"
    },
    {
      "name": "IN_N",
      "direction": "input",
      "kind": "analog"
    },
    {
      "name": "OUT",
      "direction": "output",
      "kind": "analog"
    },
    {
