      "connections": {
        "B": "GND",
        "D": "mirror_gate",
        "G": "IN_P",
        "S": "tnode"
      },
      "params": {
        "L": "180n",
        "M": "1",
        "W": "2u"
      },
      "process": "nmos"
    },
    {
      "kind": "nmos",
      "name": "dp.M_P",
      "connections": {
        "B": "GND",
        "D": "OUT",
        "G": "IN_N",
        "S": "tnode"
      },
      "params": {
        "L": "180n",
        "M": "1",
        "W": "2u"
      },
      "process": "nmos"
    },
    {
      "kind": "nmos",
      "name": "dp.M_TAIL",
      "connections": {
        "B": "GND",
        "D": "tnode",
        "G": "VTAIL",
        "S": "GND"
      },
      "params": {
        "L": "180n",
        "M": "1",
        "W": "4u"
      },
      "process": "nmos"
    },
    {
      "kind": "pmos",
      "name": "cm.M_SENSE",
      "connections": {
        "B": "VDD",
        "D": "mirror_gate",
        "G": "mirror_gate",
        "S": "VDD"
      },
      "params": {
        "L": "180n",
        "M": "1",
        "W": "2u"
      },
      "process": "pmos"
    },
    {
      "kind": "pmos",
      "name": "cm.M_TAP0",
      "connections": {
        "B": "VDD",
        "D": "OUT",
        "G": "mirror_gate",
        "S": "VDD"
      },
      "params": {
        "L": "180n",
        "M": "1",
        "W": "2u"
      },
      "process": "pmos"
    }
  ],
  "constraints": {
    "numeric": [
      {
        "id": "c_gbw",
        "bench": "ACBench",
        "metric": "GainBandwidth",
        "node": "net::OUT",
        "op": ">=",
        "value": 20000000,
        "unit": "Hz"
      },
      {
        "id": "c_gain",
        "bench": "ACBench",
        "metric": "PassbandGain",
        "node": "net::OUT",
        "op": ">=",
        "value": 40,
        "unit": "dB"
      },
      {
        "id": "c_pm",
        "bench": "ACBench",
        "metric": "PhaseMargin",
        "node": "net::OUT",
        "op": ">=",
        "value": 60,
        "unit": "deg"
      },
      {
        "id": "c_pwr",
        "bench": "DCBench",
        "metric": "QuiescentPower",
        "op": "<=",
        "value": 0.0005,
        "unit": "W"
      },
      {
        "id": "c_swing",
        "bench": "TranBench",
        "metric": "SingleEndedOutputSwing",
        "node": "net::OUT",
        "op": ">=",
        "value": 1.2,
        "unit": "Vpp"
      }
    ],
    "tech": [
      {
        "id": "t_lmin",
        "metric": "L",
        "op": ">=",
        "value": 1.8000000000000002E-07,
        "unit": "m",
        "scope": "*"
      }
    ]
