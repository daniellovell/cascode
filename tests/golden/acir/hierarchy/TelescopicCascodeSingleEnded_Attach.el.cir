ACIR 3.0

bundle Diff:
  P : analog
  N : analog

trait DiffPairLike:
  port OUT : Diff

trait LoadPairLike:
  port BIAS : bias
  port DRAIN : Diff
  port SOURCE : Diff
  connectors:
    to DiffPairLike:
      DRAIN--OUT
    to LoadPairLike:
      DRAIN--SOURCE

trait CurrentMirrorLike:
  port RAIL : Diff
  port SENSE : analog
  port TAP[0] : analog
  connectors:
    to LoadPairLike:
      SENSE--SOURCE.N
      TAP[0]--SOURCE.P
    to CurrentMirrorLike:
      SENSE--RAIL.N
      TAP[0]--RAIL.P

bench ACBench for SingleEndedOpAmp
  builtin SEOpAmpACBench
  outputs:
    GainBandwidth
    PassbandGain
    PhaseMargin

bench DCBench for SingleEndedOpAmp
  builtin SEOpAmpDCBench
  outputs:
    QuiescentPower

circuit TelescopicCascodeSingleEnded_Attach implements SingleEndedOpAmp
  level EL
  supply VDD
  ground GND
  port IN : Diff
  port OUT : analog
  port VBN : bias
  port VTAIL : bias
  fill:
    inst dp (.GND--GND, .VDD--VDD) : DiffPair
      size InputPair = (W=2u, L=180n, M=1)
      size Tail = (W=4u, L=180n, M=1)
    inst nl (.GND--GND, .VDD--VDD) : LoadPair_N
      size Cascode = (W=2u, L=180n, M=1)
    inst cm_lo (.GND--GND, .VDD--VDD) : CurrentMirror_P
      size Mirror = (W=2u, L=180n, M=1)
    inst cm_hi (.GND--GND, .VDD--VDD) : CurrentMirror_P
      size Mirror = (W=2u, L=180n, M=1)
    attach nl to dp via LoadPairLike::DiffPairLike as n_stack
    attach cm_lo to nl via CurrentMirrorLike::LoadPairLike as mirror_lo
    attach cm_hi to cm_lo via CurrentMirrorLike::CurrentMirrorLike as mirror_hi
    dp.IN--IN
    dp.TAIL--VTAIL
    nl.BIAS--VBN
    cm_lo.TAP[0]--OUT
    cm_hi.RAIL--VDD
  constraints:
    numeric:
      c_gbw : ACBench::GainBandwidth >= 40MHz
      c_gain : ACBench::PassbandGain >= 30dB
      c_pm : ACBench::PhaseMargin >= 60deg
      c_pwr : DCBench::QuiescentPower <= 1mW
    tech:
      t_lmin : L >= 180nm on *
  harness:
    supply VDD = 1.8V
    bias VBN = 0.9V
    bias VTAIL = 0.6V
    load OUT C=1pF

circuit DiffPair implements DiffPairLike
  level EL
  inline
  size InputPair
  size Tail
  supply VDD
  ground GND
  port IN : Diff
  port OUT : Diff
  port TAIL : bias
  fill:
    net tnode : analog
    nmos M_N (.B--GND, .D--OUT.N, .G--IN.P, .S--tnode) : nmos
      size InputPair
    nmos M_P (.B--GND, .D--OUT.P, .G--IN.N, .S--tnode) : nmos
      size InputPair
    nmos M_TAIL (.B--GND, .D--tnode, .G--TAIL, .S--GND) : nmos
      size Tail

circuit LoadPair_N implements LoadPairLike
  level EL
  inline
  size Cascode
  supply VDD
  ground GND
  port BIAS : bias
  port DRAIN : Diff
  port SOURCE : Diff
  fill:
    nmos M_P (.B--GND, .D--SOURCE.P, .G--BIAS, .S--DRAIN.P) : nmos
      size Cascode
    nmos M_N (.B--GND, .D--SOURCE.N, .G--BIAS, .S--DRAIN.N) : nmos
      size Cascode

circuit CurrentMirror_P implements CurrentMirrorLike
  level EL
  inline
  param ratio : real = 1
  size Mirror
  supply VDD
  ground GND
  port RAIL : Diff
  port SENSE : analog
  port TAP[0] : analog
  fill:
    pmos M_SENSE (.B--VDD, .D--SENSE, .G--SENSE, .S--RAIL.N) : pmos
      size Mirror
    pmos M_TAP0 (.B--VDD, .D--TAP[0], .G--SENSE, .S--RAIL.P) : pmos
      size Mirror
      M = $ratio
