ACIR 2.0

bundle Diff:
  P : analog
  N : analog

trait CurrentMirrorLike:
  port SENSE : analog
  port TAP[0] : analog
  connectors:
    to DiffPairLike:
      SENSE -> OUT.N
      TAP[0] -> OUT.P

trait DiffPairLike:
  port OUT.P : analog
  port OUT.N : analog

circuit OTA5T_Hierarchical_Attach
  level EL
  supply VDD
  ground GND
  port IN_P : analog
  port IN_N : analog
  port OUT : analog
  port VTAIL : bias
  fill:
    inst dp (GND->GND, IN_N->IN_N, IN_P->IN_P, OUT.P->OUT, TAIL->VTAIL, VDD->VDD) : DiffPair
      size InputPair = (W=2u, L=180n, M=1)
      size Tail = (W=4u, L=180n, M=1)
    inst cm (GND->GND, TAP[0]->OUT, VDD->VDD) : CurrentMirror
      param ratio = 1
    attach cm to dp via CurrentMirrorLike::DiffPairLike as mirror_node
  constraints:
    numeric:
      c_gbw : GainBandwidth @ OUT >= 20M Hz
      c_gain : PassbandGain @ OUT >= 40 dB
      c_pm : PhaseMargin @ OUT >= 60 deg
      c_pwr : QuiescentPower <= 500u W
    measure:
      m_gbw : SEOpAmpACBench GainBandwidth @ OUT
      m_gain : SEOpAmpACBench PassbandGain @ OUT
      m_pm : SEOpAmpACBench PhaseMargin @ OUT
      m_pwr : SEOpAmpDCBench QuiescentPower
  harness:
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    load OUT C=1pF
  benches:
    SEOpAmpACBench
    SEOpAmpDCBench

circuit DiffPair : DiffPairLike
  level EL
  inline
  size InputPair
  size Tail
  supply VDD
  ground GND
  port IN_P : analog
  port IN_N : analog
  port OUT.P : analog
  port OUT.N : analog
  port TAIL : bias
  fill:
    net tnode : analog
    nmos M_N (B->GND, D->OUT.N, G->IN_P, S->tnode) : size=InputPair nmos
    nmos M_P (B->GND, D->OUT.P, G->IN_N, S->tnode) : size=InputPair nmos
    nmos M_TAIL (B->GND, D->tnode, G->TAIL, S->GND) : size=Tail nmos

circuit CurrentMirror : CurrentMirrorLike
  level EL
  param ratio : real = 1
  size Sense = (W=2u, L=180n, M=1)
  supply VDD
  ground GND
  port SENSE : analog
  port TAP[0] : analog
  fill:
    pmos M_SENSE (B->VDD, D->SENSE, G->SENSE, S->VDD) : size=Sense pmos
    pmos M_TAP0 (B->VDD, D->TAP[0], G->SENSE, S->VDD) : M=$ratio size=Sense pmos
