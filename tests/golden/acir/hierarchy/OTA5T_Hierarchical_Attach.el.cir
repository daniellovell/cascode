ACIR 2.0

bundle Diff:
  P : analog
  N : analog

trait CurrentMirrorLike:
  port SENSE : analog
  port TAP[0] : analog
  connectors:
    to DiffPairLike:
      SENSE -> OUT.N
      TAP[0] -> OUT.P

trait DiffPairLike:
  port OUT.P : analog
  port OUT.N : analog

circuit OTA5T_Hierarchical_Attach
  level EL
  supply VDD
  ground GND
  port IN_P : analog
  port IN_N : analog
  port OUT : analog
  port VTAIL : bias
  fill:
    inst dp (GND->GND, IN_N->IN_N, IN_P->IN_P, OUT.N->OUT, TAIL->VTAIL, VDD->VDD) : DiffPair
      param Win = 2u
      param Lin = 180n
      param Min = 1
      param Wtail = 4u
      param Ltail = 180n
      param Mtail = 1
    inst cm (GND->GND, TAP[0]->OUT, VDD->VDD) : CurrentMirror
      param W = 2u
      param L = 180n
      param ratio = 1
    attach cm to dp via CurrentMirrorLike::DiffPairLike as mirror_node
  constraints:
    numeric:
      c_gbw : GainBandwidth @ OUT >= 20M Hz
      c_gain : PassbandGain @ OUT >= 40 dB
      c_pm : PhaseMargin @ OUT >= 60 deg
      c_pwr : QuiescentPower <= 500u W
    measure:
      m_gbw : SEOpAmpACBench GainBandwidth @ OUT
      m_gain : SEOpAmpACBench PassbandGain @ OUT
      m_pm : SEOpAmpACBench PhaseMargin @ OUT
      m_pwr : SEOpAmpDCBench QuiescentPower
  harness:
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    load OUT C=1pF
  benches:
    SEOpAmpACBench
    SEOpAmpDCBench

circuit DiffPair : DiffPairLike
  level EL
  inline
  param Win : real
  param Lin : real
  param Min : real
  param Wtail : real
  param Ltail : real
  param Mtail : real
  supply VDD
  ground GND
  port IN_P : analog
  port IN_N : analog
  port OUT.P : analog
  port OUT.N : analog
  port TAIL : bias
  fill:
    net tnode : analog
    nmos M_N (B->GND, D->OUT.P, G->IN_P, S->tnode) : L=$Lin M=$Min W=$Win nmos
    nmos M_P (B->GND, D->OUT.N, G->IN_N, S->tnode) : L=$Lin M=$Min W=$Win nmos
    nmos M_TAIL (B->GND, D->tnode, G->TAIL, S->GND) : L=$Ltail M=$Mtail W=$Wtail nmos

circuit CurrentMirror : CurrentMirrorLike
  level EL
  param W : real
  param L : real
  param ratio : real = 1
  supply VDD
  ground GND
  port SENSE : analog
  port TAP[0] : analog
  fill:
    pmos M_SENSE (B->VDD, D->SENSE, G->SENSE, S->VDD) : L=$L M=1 W=$W pmos
    pmos M_TAP0 (B->VDD, D->TAP[0], G->SENSE, S->VDD) : L=$L M=$ratio W=$W pmos
