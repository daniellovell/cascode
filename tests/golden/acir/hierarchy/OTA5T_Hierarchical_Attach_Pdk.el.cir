ACIR 3.0

bundle Diff:
  P : analog
  N : analog

trait CurrentMirrorLike:
  input SENSE : analog
  output TAP[0] : analog
  connectors:
    to DiffPairLike:
      SENSE--OUT.N
      TAP[0]--OUT.P

trait DiffPairLike:
  output OUT : Diff

bench ACBench for SingleEndedOpAmp
  builtin SEOpAmpACBench
  outputs:
    GainBandwidth
    PassbandGain
    PhaseMargin

bench DCBench for SingleEndedOpAmp
  builtin SEOpAmpDCBench
  outputs:
    QuiescentPower

circuit OTA5T_Hierarchical_Attach_Pdk implements SingleEndedOpAmp
  level EL
  supply VDD
  ground GND
  input IN : Diff
  output OUT : analog
  input VTAIL : bias
  fill:
    inst dp : DiffPair_Pdk
      size InputPair = (W=2u, L=180n, M=1)
      size Tail = (W=4u, L=180n, M=1)
      .GND--GND
      .VDD--VDD
      .IN--IN
      .OUT.P--OUT
      .TAIL--VTAIL
    inst cm : CurrentMirror_Pdk
      param ratio = 1
      .GND--GND
      .VDD--VDD
      // TAP[0]--OUT intentionally omitted - covered by attach statement below
    attach cm to dp via CurrentMirrorLike::DiffPairLike as mirror_node
  constraints:
    numeric:
      c_gbw : ACBench::GainBandwidth at net::OUT >= 20MHz
      c_gain : ACBench::PassbandGain at net::OUT >= 40dB
      c_pm : ACBench::PhaseMargin at net::OUT >= 60deg
      c_pwr : DCBench::QuiescentPower <= 500uW
  harness:
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    load OUT C=1pF

circuit DiffPair_Pdk implements DiffPairLike
  level EL
  inline
  size InputPair
  size Tail
  supply VDD
  ground GND
  input IN : Diff
  output OUT : Diff
  input TAIL : bias
  fill:
    net tnode : analog
    nmos M_N (.B--GND, .D--OUT.N, .G--IN.P, .S--tnode) : nfet_01v8
      size InputPair
    nmos M_P (.B--GND, .D--OUT.P, .G--IN.N, .S--tnode) : nfet_01v8
      size InputPair
    nmos M_TAIL (.B--GND, .D--tnode, .G--TAIL, .S--GND) : nfet_01v8
      size Tail

circuit CurrentMirror_Pdk implements CurrentMirrorLike
  level EL
  param ratio : real = 1
  size Sense = (W=2u, L=180n, M=1)
  supply VDD
  ground GND
  input SENSE : analog
  output TAP[0] : analog
  fill:
    pmos M_SENSE (.B--VDD, .D--SENSE, .G--SENSE, .S--VDD) : pfet_01v8
      size Sense
    pmos M_TAP0 (.B--VDD, .D--TAP[0], .G--SENSE, .S--VDD) : pfet_01v8
      size Sense
      M = $ratio
