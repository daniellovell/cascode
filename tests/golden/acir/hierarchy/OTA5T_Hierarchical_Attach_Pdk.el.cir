ACIR 3.0

bundle Diff:
  P : analog
  N : analog

trait CurrentMirrorLike:
  port SENSE : analog
  port TAP[0] : analog
  connectors:
    to DiffPairLike:
      SENSE -> OUT.N
      TAP[0] -> OUT.P

trait DiffPairLike:
  port OUT : Diff

circuit OTA5T_Hierarchical_Attach_Pdk
  level EL
  supply VDD
  ground GND
  port IN : Diff
  port OUT : analog
  port VTAIL : bias
  fill:
    inst dp (dp.GND->GND, dp.VDD->VDD) : DiffPair_Pdk
      size InputPair = (W=2u, L=180n, M=1)
      size Tail = (W=4u, L=180n, M=1)
      connect dp.IN -> IN
      connect dp.OUT.P -> OUT
      connect VTAIL -> dp.TAIL
    inst cm (cm.GND->GND, cm.VDD->VDD) : CurrentMirror_Pdk
      param ratio = 1
      // TAP[0]->OUT intentionally omitted - covered by attach statement below
    attach cm to dp via CurrentMirrorLike::DiffPairLike as mirror_node
  constraints:
    numeric:
      c_gbw : GainBandwidth @ OUT >= 20MHz
      c_gain : PassbandGain @ OUT >= 40dB
      c_pm : PhaseMargin @ OUT >= 60deg
      c_pwr : QuiescentPower <= 500uW
    measure:
      m_gbw : SEOpAmpACBench GainBandwidth @ OUT
      m_gain : SEOpAmpACBench PassbandGain @ OUT
      m_pm : SEOpAmpACBench PhaseMargin @ OUT
      m_pwr : SEOpAmpDCBench QuiescentPower
  harness:
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    load OUT C=1pF
  benches:
    SEOpAmpACBench
    SEOpAmpDCBench

circuit DiffPair_Pdk : DiffPairLike
  level EL
  inline
  size InputPair
  size Tail
  supply VDD
  ground GND
  port IN : Diff
  port OUT : Diff
  port TAIL : bias
  fill:
    net tnode : analog
    nmos M_N (B->GND, D->OUT.N, G->IN.P, S->tnode) : size=InputPair nfet_01v8
    nmos M_P (B->GND, D->OUT.P, G->IN.N, S->tnode) : size=InputPair nfet_01v8
    nmos M_TAIL (B->GND, D->tnode, G->TAIL, S->GND) : size=Tail nfet_01v8

circuit CurrentMirror_Pdk : CurrentMirrorLike
  level EL
  param ratio : real = 1
  size Sense = (W=2u, L=180n, M=1)
  supply VDD
  ground GND
  port SENSE : analog
  port TAP[0] : analog
  fill:
    pmos M_SENSE (B->VDD, D->SENSE, G->SENSE, S->VDD) : size=Sense pfet_01v8
    pmos M_TAP0 (B->VDD, D->TAP[0], G->SENSE, S->VDD) : M=$ratio size=Sense pfet_01v8
