ACIR 3.0

trait CurrentMirrorLike:
  input SENSE : analog
  output TAP[0] : analog
  connectors:
    to LoadBranch:
      TAP[0]--IN

circuit CurrentMirror implements CurrentMirrorLike
  level EL
  param ratio : real = 1
  supply VDD
  ground GND
  input SENSE : analog
  output TAP[0] : analog
  fill:
    pmos M_SENSE (.B--VDD, .D--SENSE, .G--SENSE, .S--VDD) : pmos
      size (W=2u, L=180n, M=1)
    pmos M_TAP0 (.B--VDD, .D--TAP[0], .G--SENSE, .S--VDD) : pmos
      size (W=2u, L=180n, M=$ratio)
  constraints:
    tech:
      t_lmin : L >= 180nm on *
