ACIR 2.0

bundle Diff:
  P : analog
  N : analog

trait DiffPairLike:
  port OUT : Diff

trait LoadPairLike:
  port BIAS : bias
  port DRAIN : Diff
  port SOURCE : Diff
  connectors:
    to DiffPairLike:
      DRAIN -> OUT
    to LoadPairLike:
      DRAIN -> SOURCE

circuit TelescopicCascodeFullyDiff_Attach
  level EL
  supply VDD
  ground GND
  port IN : Diff
  port OUT : Diff
  port VBN : bias
  port VBP1 : bias
  port VBP2 : bias
  port VTAIL : bias
  fill:
    inst dp (dp.GND->GND, dp.VDD->VDD) : DiffPair
      size InputPair = (W=4u, L=500n, M=1)
      size Tail = (W=8u, L=500n, M=1)
    inst nl (nl.GND->GND, nl.VDD->VDD) : LoadPair_N
      size Cascode = (W=4u, L=500n, M=1)
    inst pl1 (pl1.GND->GND, pl1.VDD->VDD) : LoadPair_P
      size Cascode = (W=8u, L=500n, M=1)
    inst pl2 (pl2.GND->GND, pl2.VDD->VDD) : LoadPair_P
      size Cascode = (W=8u, L=500n, M=1)
    attach nl to dp via LoadPairLike::DiffPairLike as n_stack
    attach pl2 to pl1 to nl via LoadPairLike::LoadPairLike as p_stack
    connect dp.IN -> IN
    connect dp.TAIL -> VTAIL
    connect nl.BIAS -> VBN
    connect nl.SOURCE -> OUT
    connect pl1.BIAS -> VBP1
    connect pl2.BIAS -> VBP2
    connect pl2.SOURCE -> VDD
  constraints:
    numeric:
      c_gbw : GainBandwidth >= 500k Hz
      c_gain : PassbandGain >= 2 dB
      c_pm : PhaseMargin >= 60 deg
      c_pwr : QuiescentPower <= 1m W
    tech:
      t_lmin : L >= 500n m on *
    measure:
      m_gbw : FDOpAmpACBench GainBandwidth
      m_gain : FDOpAmpACBench PassbandGain
      m_pm : FDOpAmpACBench PhaseMargin
      m_pwr : FDOpAmpDCBench QuiescentPower
  harness:
    supply VDD = 1.8V
    bias VBN = 0.75V
    bias VBP1 = 1.0V
    bias VBP2 = 1.1V
    bias VTAIL = 0.7V
    load OUT (C=1pF || R=1G)
  benches:
    FDOpAmpACBench
    FDOpAmpDCBench

circuit DiffPair : DiffPairLike
  level EL
  inline
  size InputPair
  size Tail
  supply VDD
  ground GND
  port IN : Diff
  port OUT : Diff
  port TAIL : bias
  fill:
    net tnode : analog
    nmos M_N (B->GND, D->OUT.P, G->IN.P, S->tnode) : size=InputPair nmos
    nmos M_P (B->GND, D->OUT.N, G->IN.N, S->tnode) : size=InputPair nmos
    nmos M_TAIL (B->GND, D->tnode, G->TAIL, S->GND) : size=Tail nmos

circuit LoadPair_N : LoadPairLike
  level EL
  inline
  size Cascode
  supply VDD
  ground GND
  port BIAS : bias
  port DRAIN : Diff
  port SOURCE : Diff
  fill:
    nmos M_P (B->GND, D->SOURCE.P, G->BIAS, S->DRAIN.P) : size=Cascode nmos
    nmos M_N (B->GND, D->SOURCE.N, G->BIAS, S->DRAIN.N) : size=Cascode nmos

circuit LoadPair_P : LoadPairLike
  level EL
  inline
  size Cascode
  supply VDD
  ground GND
  port BIAS : bias
  port DRAIN : Diff
  port SOURCE : Diff
  fill:
    pmos M_P (B->VDD, D->DRAIN.P, G->BIAS, S->SOURCE.P) : size=Cascode pmos
    pmos M_N (B->VDD, D->DRAIN.N, G->BIAS, S->SOURCE.N) : size=Cascode pmos
