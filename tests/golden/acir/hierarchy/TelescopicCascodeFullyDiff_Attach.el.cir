ACIR 3.0

bundle Diff:
  P : analog
  N : analog

trait DiffPairLike:
  output OUT : Diff

trait LoadPairLike:
  input BIAS : bias
  io DRAIN : Diff
  io SOURCE : Diff
  connectors:
    to DiffPairLike:
      DRAIN--OUT
    to LoadPairLike:
      DRAIN--SOURCE

bench ACBench for FullyDiffOpAmp
  builtin FDOpAmpACBench
  outputs:
    GainBandwidth
    PassbandGain
    PhaseMargin

bench DCBench for FullyDiffOpAmp
  builtin FDOpAmpDCBench
  outputs:
    QuiescentPower

circuit TelescopicCascodeFullyDiff_Attach implements FullyDiffOpAmp
  level EL
  supply VDD
  ground GND
  input IN : Diff
  output OUT : Diff
  input VBN : bias
  input VBP1 : bias
  input VBP2 : bias
  input VTAIL : bias
  fill:
    inst dp (.GND--GND, .VDD--VDD) : DiffPair
      size InputPair = (W=4u, L=500n, M=1)
      size Tail = (W=8u, L=500n, M=1)
    inst nl (.GND--GND, .VDD--VDD) : LoadPair_N
      size Cascode = (W=4u, L=500n, M=1)
    inst pl1 (.GND--GND, .VDD--VDD) : LoadPair_P
      size Cascode = (W=8u, L=500n, M=1)
    inst pl2 (.GND--GND, .VDD--VDD) : LoadPair_P
      size Cascode = (W=8u, L=500n, M=1)
    attach nl to dp via LoadPairLike::DiffPairLike as n_stack
    attach pl2 to pl1 to nl via LoadPairLike::LoadPairLike as p_stack
    dp.IN--IN
    dp.TAIL--VTAIL
    nl.BIAS--VBN
    nl.SOURCE--OUT
    pl1.BIAS--VBP1
    pl2.BIAS--VBP2
    pl2.SOURCE--VDD
  constraints:
    numeric:
      c_gbw : ACBench::GainBandwidth >= 500kHz
      c_gain : ACBench::PassbandGain >= 2dB
      c_pm : ACBench::PhaseMargin >= 60deg
      c_pwr : DCBench::QuiescentPower <= 1mW
    tech:
      t_lmin : L >= 500nm on *
  harness:
    supply VDD = 1.8V
    bias VBN = 0.75V
    bias VBP1 = 1.0V
    bias VBP2 = 1.1V
    bias VTAIL = 0.7V
    load OUT (C=1pF || R=1G)

circuit DiffPair implements DiffPairLike
  level EL
  inline
  size InputPair
  size Tail
  supply VDD
  ground GND
  input IN : Diff
  output OUT : Diff
  input TAIL : bias
  fill:
    net tnode : analog
    nmos M_N (.B--GND, .D--OUT.P, .G--IN.P, .S--tnode) : nmos
      size InputPair
    nmos M_P (.B--GND, .D--OUT.N, .G--IN.N, .S--tnode) : nmos
      size InputPair
    nmos M_TAIL (.B--GND, .D--tnode, .G--TAIL, .S--GND) : nmos
      size Tail

circuit LoadPair_N implements LoadPairLike
  level EL
  inline
  size Cascode
  supply VDD
  ground GND
  input BIAS : bias
  io DRAIN : Diff
  io SOURCE : Diff
  fill:
    nmos M_P (.B--GND, .D--SOURCE.P, .G--BIAS, .S--DRAIN.P) : nmos
      size Cascode
    nmos M_N (.B--GND, .D--SOURCE.N, .G--BIAS, .S--DRAIN.N) : nmos
      size Cascode

circuit LoadPair_P implements LoadPairLike
  level EL
  inline
  size Cascode
  supply VDD
  ground GND
  input BIAS : bias
  io DRAIN : Diff
  io SOURCE : Diff
  fill:
    pmos M_P (.B--VDD, .D--DRAIN.P, .G--BIAS, .S--SOURCE.P) : pmos
      size Cascode
    pmos M_N (.B--VDD, .D--DRAIN.N, .G--BIAS, .S--SOURCE.N) : pmos
      size Cascode
