ACIR 3.0

bundle Diff:
  P : analog
  N : analog

trait CurrentMirrorLike:
  port SENSE : analog
  port TAP[0] : analog
  connectors:
    to DiffPairLike:
      SENSE -> OUT.N
      TAP[0] -> OUT.P

trait DiffPairLike:
  port OUT : Diff

bench ACBench for SingleEndedOpAmp
  builtin SEOpAmpACBench
  outputs:
    GainBandwidth
    PassbandGain
    PhaseMargin

bench DCBench for SingleEndedOpAmp
  builtin SEOpAmpDCBench
  outputs:
    QuiescentPower

circuit OTA5T_Hierarchical implements SingleEndedOpAmp
  level EL
  supply VDD
  ground GND
  port IN : Diff
  port OUT : analog
  port VTAIL : bias
  fill:
    net mirror_gate : analog
    inst dp (dp.VDD->VDD, dp.GND->GND) : DiffPair
      size InputPair = (W=2u, L=180n, M=1)
      size Tail = (W=4u, L=180n, M=1)
      connect dp.IN -> IN
      connect dp.OUT.N -> mirror_gate
      connect dp.OUT.P -> OUT
      connect VTAIL -> dp.TAIL
    inst cm (cm.VDD->VDD, cm.GND->GND) : CurrentMirror
      param ratio = 1
      connect cm.SENSE -> mirror_gate
      connect cm.TAP[0] -> OUT
  constraints:
    numeric:
      c_gbw : ACBench::GainBandwidth at net::OUT >= 20MHz
      c_gain : ACBench::PassbandGain at net::OUT >= 40dB
      c_pm : ACBench::PhaseMargin at net::OUT >= 60deg
      c_pwr : DCBench::QuiescentPower <= 500uW
  harness:
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    load OUT C=1pF

circuit DiffPair implements DiffPairLike
  level EL
  inline
  size InputPair
  size Tail
  supply VDD
  ground GND
  port IN : Diff
  port OUT : Diff
  port TAIL : bias
  fill:
    net tnode : analog
    nmos M_N (B->GND, D->OUT.N, G->IN.P, S->tnode) : size=InputPair nmos
    nmos M_P (B->GND, D->OUT.P, G->IN.N, S->tnode) : size=InputPair nmos
    nmos M_TAIL (B->GND, D->tnode, G->TAIL, S->GND) : size=Tail nmos

circuit CurrentMirror implements CurrentMirrorLike
  level EL
  param ratio : real = 1
  size Sense = (W=2u, L=180n, M=1)
  supply VDD
  ground GND
  port SENSE : analog
  port TAP[0] : analog
  fill:
    pmos M_SENSE (B->VDD, D->SENSE, G->SENSE, S->VDD) : size=Sense pmos
    pmos M_TAP0 (B->VDD, D->TAP[0], G->SENSE, S->VDD) : M=$ratio size=Sense pmos
