ACIR 1

circuit OTA5TFullyDiff_DCSwept
  level EL
  supply VDD
  ground GND
  port IN_P : analog
  port IN_N : analog
  port OUT_P : analog
  port OUT_N : analog
  port VTAIL : bias
  fill:
    net tnode : analog
    net vcm_node : analog
    nmos dp.M_N (B->GND, D->OUT_P, G->IN_P, S->tnode) : L=180n M=1 W=2u nmos
    nmos dp.M_P (B->GND, D->OUT_N, G->IN_N, S->tnode) : L=180n M=1 W=2u nmos
    nmos dp.M_TAIL (B->GND, D->tnode, G->VTAIL, S->GND) : L=180n M=1 W=4u nmos
    pmos M_LOAD_P (B->VDD, D->OUT_P, G->vcm_node, S->VDD) : L=180n M=1 W=2u pmos
    pmos M_LOAD_N (B->VDD, D->OUT_N, G->vcm_node, S->VDD) : L=180n M=1 W=2u pmos
    resistor R_CMFB_P (P->OUT_P, N->vcm_node) : R=500k ohm
    resistor R_CMFB_N (P->OUT_N, N->vcm_node) : R=500k ohm
  constraints:
    numeric:
      c_out_cm_min : OutputDCCommonMode_min >= 0.3 V
      c_out_cm_max : OutputDCCommonMode_max <= 1.5 V
      c_power : QuiescentPower <= 800u W
    measure:
      m_out_cm_min : FDOpAmpDCBench OutputDCCommonMode_min
      m_out_cm_max : FDOpAmpDCBench OutputDCCommonMode_max
      m_power : FDOpAmpDCBench QuiescentPower
  harness:
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    sweep InputDCCommonMode [0.4V:100mV:1.4V]
    load OUT C=1pF
  benches:
    FDOpAmpDCBench

