ACIR 3.0

bundle Diff:
  P : analog
  N : analog

bench DCBench for FullyDiffOpAmp
  builtin FDOpAmpDCBench
  outputs:
    OutputDCCommonMode_min
    OutputDCCommonMode_max
    QuiescentPower

circuit OTA5TFullyDiff_DCSwept implements FullyDiffOpAmp
  level EL
  supply VDD
  ground GND
  port IN : Diff
  port OUT : Diff
  port VTAIL : bias
  fill:
    net tnode : analog
    net vcm_node : analog
    nmos dp.M_N (B->GND, D->OUT.P, G->IN.P, S->tnode) : size=(W=2u, L=180n, M=1) nmos
    nmos dp.M_P (B->GND, D->OUT.N, G->IN.N, S->tnode) : size=(W=2u, L=180n, M=1) nmos
    nmos dp.M_TAIL (B->GND, D->tnode, G->VTAIL, S->GND) : size=(W=4u, L=180n, M=1) nmos
    pmos M_LOAD_P (B->VDD, D->OUT.P, G->vcm_node, S->VDD) : size=(W=2u, L=180n, M=1) pmos
    pmos M_LOAD_N (B->VDD, D->OUT.N, G->vcm_node, S->VDD) : size=(W=2u, L=180n, M=1) pmos
    resistor R_CMFB_P (P->OUT.P, N->vcm_node) : R=500k
    resistor R_CMFB_N (P->OUT.N, N->vcm_node) : R=500k
  constraints:
    numeric:
      c_out_cm_min : DCBench::OutputDCCommonMode_min >= 0.3V
      c_out_cm_max : DCBench::OutputDCCommonMode_max <= 1.5V
      c_power : DCBench::QuiescentPower <= 800uW
  harness:
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    sweep InputDCCommonMode [0.4V:100mV:1.4V]
    load OUT C=1pF
