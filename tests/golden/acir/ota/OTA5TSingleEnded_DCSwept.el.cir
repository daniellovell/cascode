ACIR 1

circuit OTA5TSingleEnded_DCSwept
  level EL
  supply VDD
  ground GND
  port IN_P : analog
  port IN_N : analog
  port OUT : analog
  port VTAIL : bias
  fill:
    net mirror_gate : analog
    net tnode : analog
    nmos dp.M_N (B->GND, D->mirror_gate, G->IN_P, S->tnode) : L=180n M=1 W=2u nmos
    nmos dp.M_P (B->GND, D->OUT, G->IN_N, S->tnode) : L=180n M=1 W=2u nmos
    nmos dp.M_TAIL (B->GND, D->tnode, G->VTAIL, S->GND) : L=180n M=1 W=4u nmos
    pmos cm.M_SENSE (B->VDD, D->mirror_gate, G->mirror_gate, S->VDD) : L=180n M=1 W=2u pmos
    pmos cm.M_TAP0 (B->VDD, D->OUT, G->mirror_gate, S->VDD) : L=180n M=1 W=2u pmos
  constraints:
    numeric:
      c_out_bias : OutputDCBias @ OUT >= 0.4 V
      c_power : QuiescentPower <= 500u W
    measure:
      m_out_bias : SEOpAmpDCBench OutputDCBias @ OUT
      m_power : SEOpAmpDCBench QuiescentPower
  harness:
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    sweep InputDCCommonMode [0.4V:100mV:1.4V]
    load OUT C=1p F
  benches:
    SEOpAmpDCBench
