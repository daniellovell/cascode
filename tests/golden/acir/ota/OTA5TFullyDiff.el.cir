ACIR 1.1

circuit OTA5TFullyDiff
  level EL
  supply VDD
  ground GND
  port IN_P : analog
  port IN_N : analog
  port OUT_P : analog
  port OUT_N : analog
  port VTAIL : bias
  fill:
    net tnode : analog
    net vcm_node : analog
    nmos dp.M_N (B->GND, D->OUT_P, G->IN_P, S->tnode) : L=180n M=1 W=2u nmos
    nmos dp.M_P (B->GND, D->OUT_N, G->IN_N, S->tnode) : L=180n M=1 W=2u nmos
    nmos dp.M_TAIL (B->GND, D->tnode, G->VTAIL, S->GND) : L=180n M=1 W=4u nmos
    pmos M_LOAD_P (B->VDD, D->OUT_P, G->vcm_node, S->VDD) : L=180n M=1 W=2u pmos
    pmos M_LOAD_N (B->VDD, D->OUT_N, G->vcm_node, S->VDD) : L=180n M=1 W=2u pmos
    resistor R_CMFB_P (P->OUT_P, N->vcm_node) : R=500k
    resistor R_CMFB_N (P->OUT_N, N->vcm_node) : R=500k
  constraints:
    numeric:
      c_gbw : GainBandwidth >= 40M Hz
      c_gain : PassbandGain >= 30 dB
      c_pm : PhaseMargin >= 60 deg
      c_pwr : QuiescentPower <= 800u W
    tech:
      t_lmin : L >= 180n m on *
    measure:
      m_gbw : FDOpAmpACBench GainBandwidth
      m_gain : FDOpAmpACBench PassbandGain
      m_pm : FDOpAmpACBench PhaseMargin
      m_pwr : FDOpAmpDCBench QuiescentPower
  harness:
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    load OUT C=1pF
  benches:
    FDOpAmpACBench
    FDOpAmpDCBench

