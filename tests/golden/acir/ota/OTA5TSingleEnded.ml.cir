ACIR 3.0

bundle Diff:
  N : analog
  P : analog

circuit OTA5TSingleEnded implements SingleEndedOpAmp
  level ML
  supply VDD
  ground GND
  input IN : Diff
  output OUT : analog
  input VTAIL : bias
  fill:
    inst cm : CurrentMirror
    inst dp : DiffPair
      .BASE--GND
      .BIAS--VTAIL
      .IN.N--IN_N
      .IN.P--IN_P
      .OUT.N--OUT
