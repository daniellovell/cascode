ACIR 3.0

bundle Diff:
  P : analog
  N : analog

bench ACBench for SingleEndedOpAmp
  builtin SEOpAmpACBench
  outputs:
    GainBandwidth
    PassbandGain
    PhaseMargin

circuit OTA5TSingleEnded_Pdk implements SingleEndedOpAmp
  level EL
  supply VDD
  ground GND
  port IN : Diff
  port OUT : analog
  port VTAIL : bias
  fill:
    net mirror_gate : analog
    net tnode : analog
    nmos dp.M_N (B->GND, D->mirror_gate, G->IN.P, S->tnode) : size=(W=2u, L=180n, M=1) nfet_01v8
    nmos dp.M_P (B->GND, D->OUT, G->IN.N, S->tnode) : size=(W=2u, L=180n, M=1) nfet_01v8
    nmos dp.M_TAIL (B->GND, D->tnode, G->VTAIL, S->GND) : size=(W=4u, L=180n, M=1) nfet_01v8
    pmos cm.M_SENSE (B->VDD, D->mirror_gate, G->mirror_gate, S->VDD) : size=(W=2u, L=180n, M=1) pfet_01v8
    pmos cm.M_TAP0 (B->VDD, D->OUT, G->mirror_gate, S->VDD) : size=(W=2u, L=180n, M=1) pfet_01v8
  constraints:
    numeric:
      c_gbw : ACBench::GainBandwidth at net::OUT >= 1MHz
      c_gain : ACBench::PassbandGain at net::OUT >= 20dB
      c_pm : ACBench::PhaseMargin at net::OUT >= 60deg
    tech:
      t_lmin : L >= 180nm on *
  harness:
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    load OUT C=1pF
