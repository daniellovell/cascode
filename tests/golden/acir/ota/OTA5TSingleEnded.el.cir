ACIR 3.0

primitive nmos Level1_NMOS(size primSize) {
  device "level1_nmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}

primitive pmos Level1_PMOS(size primSize) {
  device "level1_pmos"
  params {
    W = primSize.W
    L = primSize.L
    m = primSize.M
  }
}


bundle Diff {
  P : analog
  N : analog

}
bench ACBench for SingleEndedOpAmp {
  builtin SEOpAmpACBench
  outputs {
    GainBandwidth
    PassbandGain
    PhaseMargin
    LowpassBandwidth
    HighpassBandwidth
    BandpassBandwidth

  }
}
bench DCBench for SingleEndedOpAmp {
  builtin SEOpAmpDCBench
  outputs {
    QuiescentPower

  }
}
bench TranBench for SingleEndedOpAmp {
  builtin SEOpAmpTranBench
  outputs {
    SingleEndedOutputSwing

  }
}
circuit OTA5TSingleEnded implements SingleEndedOpAmp {
  level EL
  supply VDD
  ground GND
  input IN : Diff
  output OUT : analog
  input VTAIL : bias
  fill {
    net mirror_gate : analog
    net tnode : analog
    nmos dp.M_N = new Level1_NMOS(size(W=2u, L=180n, M=1)) {
      .B--GND
      .D--mirror_gate
      .G--IN.P
      .S--tnode
    }
    nmos dp.M_P = new Level1_NMOS(size(W=2u, L=180n, M=1)) {
      .B--GND
      .D--OUT
      .G--IN.N
      .S--tnode
    }
    nmos dp.M_TAIL = new Level1_NMOS(size(W=4u, L=180n, M=1)) {
      .B--GND
      .D--tnode
      .G--VTAIL
      .S--GND
    }
    pmos cm.M_SENSE = new Level1_PMOS(size(W=2u, L=180n, M=1)) {
      .B--VDD
      .D--mirror_gate
      .G--mirror_gate
      .S--VDD
    }
    pmos cm.M_TAP0 = new Level1_PMOS(size(W=2u, L=180n, M=1)) {
      .B--VDD
      .D--OUT
      .G--mirror_gate
      .S--VDD
    }
  }
  constraints {
    numeric {
      c_gbw = ACBench::GainBandwidth at net::OUT >= 20MHz
      c_gain = ACBench::PassbandGain at net::OUT >= 40dB
      c_pm = ACBench::PhaseMargin at net::OUT >= 60deg
      c_pwr = DCBench::QuiescentPower <= 500uW
      c_swing = TranBench::SingleEndedOutputSwing at net::OUT >= 1.2Vpp
    }
    tech {
      t_lmin : L >= 180nm on *
    }
  }
  harness {
    supply VDD = 1.8V
    bias VTAIL = 0.6V
    load OUT C=1pF
  }
}
