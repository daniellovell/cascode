ACIR 3.0

primitive capacitor Ideal_Capacitor(size primSize) {
  device "capacitor"
  params {
    C = primSize.C
  }
}

primitive resistor Ideal_Resistor(size primSize) {
  device "resistor"
  params {
    R = primSize.R
  }
}


circuit DiffRCFilter implements DifferentialFilter {
  level EL
  supply VDD
  ground GND
  input IN_P : analog
  input IN_N : analog
  output OUT.P : analog
  output OUT.N : analog
  fill {
    resistor R_P = new Ideal_Resistor(size(R=10k)) {
      .P--IN_P
      .N--OUT.P
    }
    resistor R_N = new Ideal_Resistor(size(R=10k)) {
      .P--IN_N
      .N--OUT.N
    }
    capacitor C_DIFF = new Ideal_Capacitor(size(C=1p)) {
      .P--OUT.P
      .N--OUT.N
    }
  }
  harness {
    supply VDD = 1.8V
  }
}
