ACIR 3.0

circuit DiffRCFilter implements DifferentialFilter
  level EL
  supply VDD
  ground GND
  input IN_P : analog
  input IN_N : analog
  output OUT_P : analog
  output OUT_N : analog
  fill:
    resistor R_P (.P--IN_P, .N--OUT_P) : resistor
      R = 10k
    resistor R_N (.P--IN_N, .N--OUT_N) : resistor
      R = 10k
    capacitor C_DIFF (.P--OUT_P, .N--OUT_N) : capacitor
      C = 1p
  harness:
    supply VDD = 1.8V
