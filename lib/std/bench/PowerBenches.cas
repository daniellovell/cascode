VERSION 3.0

library lib.std.bench

// Golden bench definition 
bench QuiescentPower(Voltage supplyVoltage) {
  term PWR : supply
  term RET : ground

  fill {
    GND g = new GND() {
      .GND--RET
    }

    VDC src = new VDC(V=supplyVoltage) {
      .P--PWR
      .N--RET
    }
  }

  measurements {
    measurement QuiescentPower : W {
      // Positive static power drawn from the single rail under test.
      // Intended sign convention matches the legacy ngspice template:
      //   P = (V(PWR)-V(RET)) * (-I(Vsrc))
      return quiescent_power(PWR, RET)
    }
  }
}

//


