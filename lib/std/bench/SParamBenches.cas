VERSION 4.0

library lib.std.bench

function get_source_impedance(Impedance fallback) : Impedance {
  if env.SourceImpedance { return env.SourceImpedance }
  return fallback
}

function get_load_impedance(Impedance fallback) : Impedance {
  if env.LoadImpedance { return env.LoadImpedance }
  return fallback
}

abstract bench AbstractTwoPortSParam {
  resp P1 : analog
  resp P2 : analog

  analysis {
    SPAnalysis sp = new SPAnalysis(
      space=Log,
      samples=100,
      start=(if constraints.HighpassBandwidth { constraints.HighpassBandwidth * 0.1 } else { 1Hz }),
      stop=(if constraints.GainBandwidth { constraints.GainBandwidth * 10 } else { 10GHz }))
  }

  measurements {
    measurement ForwardGain(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(S.S(2, 1).Mag()).ValueAt(f)
    }

    measurement InputReturnLoss(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return S.ReturnLoss(1).ValueAt(f)
    }

    measurement OutputReturnLoss(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return S.ReturnLoss(2).ValueAt(f)
    }

    measurement ReverseIsolation(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return S.Isolation(1, 2).ValueAt(f)
    }

    measurement InputVSWR(Frequency f) : Scalar {
      SParameterMatrix S = sparam(sp)
      return S.VSWR(1).ValueAt(f)
    }

    measurement StabilityK(Frequency f) : Scalar {
      SParameterMatrix S = sparam(sp)
      return S.StabilityK().ValueAt(f)
    }

    measurement MaxAvailableGain(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(S.MAG()).ValueAt(f)
    }

    measurement ForwardGroupDelay(Frequency f) : s {
      SParameterMatrix S = sparam(sp)
      return S.GroupDelay(2, 1).ValueAt(f)
    }
  }
}

bench TwoPortSParam extends AbstractTwoPortSParam {
  resp P1 : analog
  resp P2 : analog

  fill {
    net gnd : ground

    GND _ = new GND() {
      .GND--gnd
    }

    Port port1 = new Port(N=1, Z=get_source_impedance(50Ohm), V=env.InputCommonModeRange) {
      .P--P1
      .N--gnd
    }

    Port port2 = new Port(N=2, Z=get_load_impedance(50Ohm), V=env.OutputCommonModeRange) {
      .P--P2
      .N--gnd
    }
  }
}

bench TwoPortSParamNoise extends AbstractTwoPortSParam {
  resp P1 : analog
  resp P2 : analog

  override analysis {
    SPAnalysis sp = new SPAnalysis(
      space=Log,
      samples=100,
      start=(if constraints.HighpassBandwidth { constraints.HighpassBandwidth * 0.1 } else { 1Hz }),
      stop=(if constraints.GainBandwidth { constraints.GainBandwidth * 10 } else { 10GHz }),
      noise=1)
  }

  fill {
    net gnd : ground

    GND _ = new GND() {
      .GND--gnd
    }

    Port port1 = new Port(N=1, Z=get_source_impedance(50Ohm), V=env.InputCommonModeRange) {
      .P--P1
      .N--gnd
    }

    Port port2 = new Port(N=2, Z=get_load_impedance(50Ohm), V=env.OutputCommonModeRange) {
      .P--P2
      .N--gnd
    }
  }

  measurements {
    measurement NoiseFigure(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return S.NF().ValueAt(f)
    }
  }
}

bench TwoPortMixedModeSParam {
  resp P1 : Diff
  resp P2 : Diff

  analysis {
    SPAnalysis sp = new SPAnalysis(
      space=Log,
      samples=100,
      start=(if constraints.HighpassBandwidth { constraints.HighpassBandwidth * 0.1 } else { 1Hz }),
      stop=(if constraints.GainBandwidth { constraints.GainBandwidth * 10 } else { 10GHz }))
  }

  fill {
    net gnd : ground

    GND _ = new GND() {
      .GND--gnd
    }

    Port port1 = new Port(N=1, Z=get_source_impedance(50Ohm), V=env.InputCommonModeRange) {
      .P--P1.P
      .N--gnd
    }

    Port port2 = new Port(N=2, Z=get_load_impedance(50Ohm), V=env.OutputCommonModeRange) {
      .P--P2.P
      .N--gnd
    }

    Port port3 = new Port(N=3, Z=get_source_impedance(50Ohm), V=env.InputCommonModeRange) {
      .P--P1.N
      .N--gnd
    }

    Port port4 = new Port(N=4, Z=get_load_impedance(50Ohm), V=env.OutputCommonModeRange) {
      .P--P2.N
      .N--gnd
    }
  }

  measurements {
    measurement Sdd11(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(((S.S(1, 1) - S.S(1, 3) - S.S(3, 1) + S.S(3, 3)) / 2).Mag()).ValueAt(f)
    }

    measurement Sdd12(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(((S.S(1, 2) - S.S(1, 4) - S.S(3, 2) + S.S(3, 4)) / 2).Mag()).ValueAt(f)
    }

    measurement Sdd21(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(((S.S(2, 1) - S.S(2, 3) - S.S(4, 1) + S.S(4, 3)) / 2).Mag()).ValueAt(f)
    }

    measurement Sdd22(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(((S.S(2, 2) - S.S(2, 4) - S.S(4, 2) + S.S(4, 4)) / 2).Mag()).ValueAt(f)
    }

    measurement Sdc11(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(((S.S(1, 1) + S.S(1, 3) - S.S(3, 1) - S.S(3, 3)) / 2).Mag()).ValueAt(f)
    }

    measurement Sdc12(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(((S.S(1, 2) + S.S(1, 4) - S.S(3, 2) - S.S(3, 4)) / 2).Mag()).ValueAt(f)
    }

    measurement Sdc21(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(((S.S(2, 1) + S.S(2, 3) - S.S(4, 1) - S.S(4, 3)) / 2).Mag()).ValueAt(f)
    }

    measurement Sdc22(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(((S.S(2, 2) + S.S(2, 4) - S.S(4, 2) - S.S(4, 4)) / 2).Mag()).ValueAt(f)
    }

    measurement Scd11(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(((S.S(1, 1) - S.S(1, 3) + S.S(3, 1) - S.S(3, 3)) / 2).Mag()).ValueAt(f)
    }

    measurement Scd12(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(((S.S(1, 2) - S.S(1, 4) + S.S(3, 2) - S.S(3, 4)) / 2).Mag()).ValueAt(f)
    }

    measurement Scd21(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(((S.S(2, 1) - S.S(2, 3) + S.S(4, 1) - S.S(4, 3)) / 2).Mag()).ValueAt(f)
    }

    measurement Scd22(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(((S.S(2, 2) - S.S(2, 4) + S.S(4, 2) - S.S(4, 4)) / 2).Mag()).ValueAt(f)
    }

    measurement Scc11(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(((S.S(1, 1) + S.S(1, 3) + S.S(3, 1) + S.S(3, 3)) / 2).Mag()).ValueAt(f)
    }

    measurement Scc12(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(((S.S(1, 2) + S.S(1, 4) + S.S(3, 2) + S.S(3, 4)) / 2).Mag()).ValueAt(f)
    }

    measurement Scc21(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(((S.S(2, 1) + S.S(2, 3) + S.S(4, 1) + S.S(4, 3)) / 2).Mag()).ValueAt(f)
    }

    measurement Scc22(Frequency f) : dB {
      SParameterMatrix S = sparam(sp)
      return db20(((S.S(2, 2) + S.S(2, 4) + S.S(4, 2) + S.S(4, 4)) / 2).Mag()).ValueAt(f)
    }
  }
}
