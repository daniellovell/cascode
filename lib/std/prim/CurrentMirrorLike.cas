package lib.std.prim;

// Interface trait: current mirror with sense and tap.
trait CurrentMirrorLike {
  params { taps: int = 1; }
  ports [ SENSE: analog ]
  ports { for i in [0:taps] { TAP[i]: analog; } }

  // Attach connectors (unified connector model):
  // - Within-trait chaining (mirror to mirror) defaults to the primary tap.
  connector { SENSE -> TAP[0]; }

  // - Mirror onto a DiffPairLike (e.g., DiffPair OUT) uses the primary tap.
  connector to DiffPairLike { SENSE -> OUT.N; TAP[0] -> OUT.P; }

  // - Mirror onto a Cascode-like stage (sense on N, tap on P) also uses the primary tap.
  connector to CascodePairLike { SENSE -> DRAIN.N; TAP[0] -> DRAIN.P; }
}
