library lib.std.prim

primitive NMOS NMOS_Level1(size primSize) {
  device "nmos_level1"
  params {
      W = primSize.W
      L = primSize.L
      m = primSize.M
  }
}
  
primitive PMOS PMOS_Level1(size primSize) {
  device "pmos_level1"
  params {
      W = primSize.W
      L = primSize.L
      m = primSize.M
  }
}
