library lib.std.prim

primitive NMOSLevel1(size primSize) implements NMOS {
  device "nmos_level1"
  params {
      W = primSize.W
      L = primSize.L
      m = primSize.M
  }
}
  
primitive PMOSLevel1(size primSize) implements PMOS {
  device "pmos_level1"
  params {
      W = primSize.W
      L = primSize.L
      m = primSize.M
  }
}
