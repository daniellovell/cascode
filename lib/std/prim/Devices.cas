library lib.std.prim

primitive Level1_NMOS(size primSize) implements NMOS {
  device "level1_nmos"
  params {
      W = primSize.W
      L = primSize.L
      m = primSize.M
  }
}
  
primitive Level1_PMOS(size primSize) implements PMOS {
  device "level1_pmos"
  params {
      W = primSize.W
      L = primSize.L
      m = primSize.M
  }
}
  