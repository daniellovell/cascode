library lib.std.prim

primitive ResistorIdeal(size primSize) implements Resistor {
  device "resistor"
  params {
    R = primSize.R
  }
}

primitive CapacitorIdeal(size primSize) implements Capacitor {
  device "capacitor"
  params {
    C = primSize.C
  }
}

primitive InductorIdeal(size primSize) implements Inductor {
  device "inductor"
  params {
    L = primSize.L
  }
}

primitive CapacitorQ(size primSize) implements Capacitor {
  device "capacitor_q"
  params {
    C = primSize.C
    Q = primSize.Q
    freq = primSize.freq
  }
}

primitive InductorQ(size primSize) implements Inductor {
  device "inductor_q"
  params {
    L = primSize.L
    Q = primSize.Q
    freq = primSize.freq
  }
}
