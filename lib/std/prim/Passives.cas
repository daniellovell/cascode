library lib.std.prim

primitive Resistor Ideal_Resistor(size primSize) {
  device "resistor"
  params {
    R = primSize.R
  }
}

primitive Capacitor Ideal_Capacitor(size primSize) {
  device "capacitor"
  params {
    C = primSize.C
  }
}

primitive Inductor Ideal_Inductor(size primSize) {
  device "inductor"
  params {
    L = primSize.L
  }
}
