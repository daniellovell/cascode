library lib.std.prim

primitive Ideal_Resistor(size primSize) implements Resistor {
  device "resistor"
  params {
    R = primSize.R
  }
}

primitive Ideal_Capacitor(size primSize) implements Capacitor {
  device "capacitor"
  params {
    C = primSize.C
  }
}

primitive Ideal_Inductor(size primSize) implements Inductor {
  device "inductor"
  params {
    L = primSize.L
  }
}
