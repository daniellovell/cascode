package lib.std.prim;

// Cascode pair motif with Diff bundle ports for source and drain.
// A single BIAS port drives both gates. Polarity selects NMOS/PMOS devices.
motif CascodePair {
  params { p: polarity = NMOS; }

  // Mandatory ports. Bundle fields are P and N.
  ports [
    DRAIN:  Diff,     // Drains of the cascode devices (P, N).
    SOURCE: Diff,     // Sources of the cascode devices (P, N).
    BIAS:   bias      // Common gate bias for both devices.
  ]

  use {
    // Left (P) branch device.
    M_P = new MOS(p) { gate <- BIAS; drain -> DRAIN.P; source -> SOURCE.P; };

    // Right (N) branch device.
    M_N = new MOS(p) { gate <- BIAS; drain -> DRAIN.N; source -> SOURCE.N; };
  }
}
