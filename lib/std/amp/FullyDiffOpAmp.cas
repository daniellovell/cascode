package lib.std.amp;

// Interface: Fully differential operational amplifier.
interface FullyDiffOpAmp extend Amplifier {
  ports [ IN: Diff, OUT: Diff ]
  supply VDD; ground GND;

  metrics {
    GainBandwidth from FDOpAmpACBench.GainBandwidth;
    PassbandGain  from FDOpAmpACBench.PassbandGain;
    PhaseMargin   from FDOpAmpStability.PhaseMargin;
    OutputDCCommonMode from FDOpAmpDCBench.OutputDCCommonMode;
    QuiescentPower from FDOpAmpDCBench.QuiescentPower;
  }
}
