package lib.std.amp.benches;

// DC characterization bench for single-ended amplifiers (single input, single output).
// Measures output DC bias and quiescent power, optionally across an input bias sweep.
bench SEAmpDCBench {
  spectre_template = "SEAmpDCBench.spectre.tpl";
  ngspice_template = "SEAmpDCBench.ngspice.tpl";
  metrics [
    InputDCBias: V,
    OutputDCBias: V,
    OutputDCBias_min: V,
    OutputDCBias_max: V,
    QuiescentPower: W
  ]
}
