package lib.std.amp.benches;

// AC bench for single-ended amplifiers.
bench SEAmplifierACBench {
  spectre_template = "SEAmplifierACBench.tpl";
  metrics [
    GainBandwidth: Hz,
    PassbandGain: dB,
    PhaseMargin: deg,
    LowpassBandwidth: Hz,
    HighpassBandwidth: Hz,
    BandpassBandwidth: Hz
  ]
}

