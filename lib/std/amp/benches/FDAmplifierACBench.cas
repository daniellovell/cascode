package lib.std.amp.benches;

// AC bench for fully differential amplifiers.
bench FDAmplifierACBench {
  spectre_template = "FDAmplifierACBench.spectre.tpl";
  ngspice_template = "FDAmplifierACBench.ngspice.tpl";
  metrics [
    GainBandwidth: Hz,
    PassbandGain: dB,
    PhaseMargin: deg,
    LowpassBandwidth: Hz,
    HighpassBandwidth: Hz,
    BandpassBandwidth: Hz
  ]
}

