library lib.std.amp
include lib.std.bench

// Interface: Fully-differential operational amplifier.
//
// This is intentionally minimal: it exists to bind the standard benches for a Diff -> Diff
// transfer function and quiescent power. Additional benches (noise, transient swing, etc.) can
// be added once the corresponding standard benches exist for Diff outputs.
interface FullyDifferentialOpAmp {
  supply VDD
  ground GND
  input IN : Diff
  output OUT : Diff
  input VTAIL : bias

  benches {
    bind QuiescentPower as vdd_pwr {
      bench.PWR--dut.VDD
      bench.RET--dut.GND
    }

    bind DiffToDiffTransfer as transfer_bench {
      bench.IN--dut.IN
      bench.OUT--dut.OUT
    }

    bind DiffCMRejection as cmrr_bench {
      bench.CM--dut.IN.P
      bench.CM--dut.IN.N
      bench.OUT--dut.OUT

      // Binding exports are adapters (not overrides): this exports a no-arg `CMRR` by forwarding to
      // the underlying bench's `CMRR(dmGain=...)` with a default dmGain source.
      measurements {
        measurement CMRR : dB = base::CMRR(dmGain=transfer_bench::PassbandGain)
      }
    }
  }
}
