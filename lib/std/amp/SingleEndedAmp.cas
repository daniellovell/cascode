library lib.std.amp
include lib.std.bench

// Interface: Single-ended amplifier (single-ended input, single-ended output).
//
// Provides ports and standard bench bindings for common small-signal and time-domain metrics.
interface SingleEndedAmp {
  supply VDD
  ground GND
  input IN : analog
  output OUT : analog

  benches {
    bind QuiescentPower as vdd_pwr {
      bench.PWR--dut.VDD
      bench.RET--dut.GND

      GND g = new GND() { .GND--gnd }
      VDC biasDC = new VDC(V=env.InputCommonModeRange) { .P--vcm, .N--gnd }
      Impedor sourceZ = new Impedor(Z=env.SourceImpedance) { .P--vcm, .N--dut.IN }
    }

    bind SEDCBias as dc_bias {
      bench.OUT--dut.OUT

      GND g = new GND() { .GND--gnd }
      VDC biasDC = new VDC(V=env.InputCommonModeRange) { .P--vcm, .N--gnd }
      Impedor sourceZ = new Impedor(Z=env.SourceImpedance) { .P--vcm, .N--dut.IN }
    }

    bind SEToSETransfer as transfer_bench {
      bench.IN--dut.IN
      bench.OUT--dut.OUT
    }

    bind SEToSENoise as noise_bench {
      bench.IN--dut.IN
      bench.OUT--dut.OUT
    }

    bind SEToSETran as tran_bench {
      bench.IN--dut.IN
      bench.OUT--dut.OUT
    }

    bind SupplyToSERejectionSEInput as psrr_bench {
      bench.IN--dut.IN
      bench.PWR--dut.VDD
      bench.OUT--dut.OUT

      measurements {
        measurement InputReferredPSRR : dB = base::InputReferredPSRR(dmGain=transfer_bench::PassbandGain)
      }
    }

    bind TwoPortSParamNoise as sparam_bench {
      bench.P1--dut.IN
      bench.P2--dut.OUT
    }
  }
}
