package lib.std.amp;

// Interface trait: Single-ended amplifier (single-ended input, single-ended output).
// Provides ports and bench metric mappings for Amplifier metrics.
trait SingleEndedAmp extend Amplifier {
  ports [ IN: analog, OUT: analog ]
  supply VDD; ground GND;

  // Declarative mapping from canonical metrics to bench metrics.
  metrics {
    GainBandwidth from SEAmpACBench.GainBandwidth;
    PassbandGain  from SEAmpACBench.PassbandGain;
    PhaseMargin   from SEAmpACBench.PhaseMargin;
    // ICMR and Swing are handled by dedicated benches; left unspecified here.
  }
}

