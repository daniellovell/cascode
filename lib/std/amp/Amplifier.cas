package lib.std.amp;

// Interface: Amplifier (spec-only)
// Declares canonical metric names; no ports are defined here.
// Interface definitions (e.g., SingleEndedOpAmp, SingleEndedAmp, FullyDiffOpAmp)
// refine this interface by adding ports and mapping metrics to benches.
interface Amplifier {
  metrics { 
    GainBandwidth; 
    PassbandGain; 
    PhaseMargin; 
    InputDCBias;           // Swept condition for SEAmp topology
    InputDCCommonMode;     // Swept condition for SEOpAmp/FDOpAmp
    OutputDCBias;          // Measured output DC level
    OutputDCCommonMode;    // Swept condition for FDOpAmp (OCMR)
    OutputSwing; 
    Power; 
    QuiescentPower;        // Static power consumption
    NoiseIn; 
    NoiseOut;
    Distortion;
  }
}
