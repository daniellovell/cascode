library lib.std.amp
include lib.std.bench

// Interface: Single-ended operational amplifier (differential input, single-ended output).
// Provides ports and bench metric mappings for Amplifier metrics.

interface SingleEndedOpAmp {
  supply VDD
  ground GND
  input IN : Diff
  output OUT : analog

  benches {
    bind QuiescentPower as vdd_pwr {
      bench.PWR--dut.VDD
      bench.RET--dut.GND

      GND g = new GND() { .GND--gnd }
      VDC commonModeVDC = new VDC(V=env.InputCommonModeRange) { .P--vcm, .N--gnd }
      Impedor sourceP = new Impedor(Z=env.SourceImpedance.DiffToShunt()) { .P--vcm, .N--dut.IN.P }
      Impedor sourceN = new Impedor(Z=env.SourceImpedance.DiffToShunt()) { .P--vcm, .N--dut.IN.N }
    }

    bind SEDCBias as dc_bias {
      bench.OUT--dut.OUT

      GND g = new GND() { .GND--gnd }
      VDC commonModeVDC = new VDC(V=env.InputCommonModeRange) { .P--vcm, .N--gnd }
      Impedor sourceP = new Impedor(Z=env.SourceImpedance.DiffToShunt()) { .P--vcm, .N--dut.IN.P }
      Impedor sourceN = new Impedor(Z=env.SourceImpedance.DiffToShunt()) { .P--vcm, .N--dut.IN.N }
    }

    bind DiffToSEInputDCCharacterization as input_dc_bench {
      bench.INP--dut.IN.P
      bench.INN--dut.IN.N
      bench.OUT--dut.OUT
    }

    bind DiffToSETransfer as transfer_bench {
      bench.IN--dut.IN
      bench.OUT--dut.OUT
    }

    bind DiffToSENoise as noise_bench {
      bench.IN--dut.IN
      bench.OUT--dut.OUT
    }

    bind DiffToSETran as tran_bench {
      bench.IN--dut.IN
      bench.OUT--dut.OUT
    }

    bind SupplyToSERejection as psrr_bench {
      bench.IN--dut.IN
      bench.PWR--dut.VDD
      bench.OUT--dut.OUT

      measurements {
        measurement InputReferredPSRR : dB = base::InputReferredPSRR(dmGain=transfer_bench::PassbandGain)
      }
    }

    bind DiffToSECMRejection as cmrr_bench {
      bench.CM--dut.IN.P
      bench.CM--dut.IN.N
      bench.OUT--dut.OUT

      measurements {
        measurement CMRR : dB = base::CMRR(dmGain=transfer_bench::PassbandGain)
      }
    }
  }
}
