library lib.std.amp
include lib.std.benches

// Interface: Single-ended operational amplifier (differential input, single-ended output).
// Provides ports and bench metric mappings for Amplifier metrics.

interface SingleEndedOpAmp {
  supply VDD
  ground VSS
  input IN : Diff
  output OUT : analog

  benches {
    bind DiffToSETransfer as transfer_bench {
      bench.IN--dut.IN
      bench.OUT--dut.OUT

      GND localGround = new GND()
      VDC dcSource = new VDC(0V) {
        .P--dut.VDD
        .N--localGround
      }
      dut.VSS--localGround
    }
  }
}
