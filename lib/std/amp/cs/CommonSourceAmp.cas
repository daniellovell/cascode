package analog.cs; import lib.std.amp.*; import lib.std.prim.*;

// Common-source amplifier motif (single-ended input, single-ended output).
// Synthesizable structural motif (no spec/bench blocks here).
motif CommonSourceAmp implements SingleEndedAmp {
  supply VDD = 1.8V; ground GND;

  // Public interface (single-ended input and output).
  ports [ IN: analog, OUT: analog, VBIAS: bias ]

  use {
    // Primitive NMOS input transistor
    M_in = new NMOS { gate -> IN; drain -> OUT; source -> GND; bulk -> GND; };

    // PMOS active load
    load = new ActiveLoad { polarity=PMOS } { node -> OUT; bias -> VBIAS; vref -> VDD; };
  }
}

