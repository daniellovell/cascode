package lib.benches;

// AC bench for single-ended operational amplifiers (differential input, single-ended output).
bench SEOpAmpACBench {
  spectre_template = "SEOpAmpACBench.spectre.tpl";
  ngspice_template = "SEOpAmpACBench.ngspice.tpl";
  metrics [
    GainBandwidth: Hz,
    PassbandGain: dB,
    PhaseMargin: deg,
    LowpassBandwidth: Hz,
    HighpassBandwidth: Hz,
    BandpassBandwidth: Hz
  ]
}

