package lib.benches;

// DC characterization bench for single-ended output operational amplifiers (differential input).
// Measures output DC bias and quiescent power, optionally across an InputDCCommonMode sweep.
bench SEOpAmpDCBench {
  spectre_template = "SEOpAmpDCBench.spectre.tpl";
  ngspice_template = "SEOpAmpDCBench.ngspice.tpl";
  metrics [
    InputDCCommonMode: V,
    OutputDCBias: V,
    OutputDCBias_min: V,
    OutputDCBias_max: V,
    QuiescentPower: W
  ]
}
