<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <!-- Use invariant globalization to avoid ICU dependency in self-contained builds -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Enable packing as a .NET global tool (optional; used on release) -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cascode</ToolCommandName>
    <PackageId>Cascode.Cli</PackageId>
    <Authors>Cascode contributors</Authors>
    <Description>Cascode CLI — synthesize, verify, and run cascode ADL flows.</Description>
    <RepositoryUrl>https://github.com/daniellovell/cascode</RepositoryUrl>
    <PackageProjectUrl>https://github.com/daniellovell/cascode</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cascode.Cli.Tests" />
    <InternalsVisibleTo Include="Cascode.Cli.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\workspace\Cascode.Workspace.csproj" />
    <ProjectReference Include="..\bench\Cascode.Bench.csproj" />
    <ProjectReference Include="..\language\Cascode.Language.csproj" />
    <ProjectReference Include="..\render\Cascode.Render.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.47.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="NgspiceVersion" Value="$(NgspiceVersion)" />
  </ItemGroup>

  <!-- Ensure README.md is included in the NuGet package for PackageReadmeFile -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <Content
      Include="Assets\ngspice-$(NgspiceVersion).sha256"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>

  <!-- Bundle lib/std alongside the published output so the CLI can resolve includes -->
  <ItemGroup>
    <Content
      Include="..\..\lib\std\**\*.cas"
      LinkBase="lib\std"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
