direction: right

acir_ll: "ACIR-LL" {style.fill: "#b4aef8"}
expander: "Expander"
gds: "GDS" {style.fill: "#b4aef8"}

acir_el: "ACIR-EL" {style.fill: "#7fdbf8"}
layout_engine: "Layout engine"
spicegen: "SPICE generator"
spice_source_netlist: "SPICE source netlist" {style.fill: "#b4aef8"}

extractor: "Extractor"
layout_netlist: "Extracted layout netlist" {style.fill: "#b4aef8"}

lvs: "LVS tool"
results: "Results" {style.fill: "#e4dbff"}

acir_ll -> expander -> gds
gds -> extractor -> layout_netlist -> lvs

acir_el -> layout_engine -> acir_ll
acir_el -> spicegen -> spice_source_netlist -> lvs
lvs -> results
