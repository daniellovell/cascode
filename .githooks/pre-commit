#!/usr/bin/env bash
set -euo pipefail

# Skip when no C# files are staged (e.g. docs-only commits).
staged_cs=$(git diff --cached --name-only --diff-filter=d -- '*.cs') || true
if [ -z "$staged_cs" ]; then
  exit 0
fi

dotnet tool restore --verbosity quiet
dotnet csharpier format .

# Re-stage any files CSharpier touched.
echo "$staged_cs" | xargs git add
